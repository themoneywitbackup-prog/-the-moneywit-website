---
---
<section class="bg-[#111111] py-28 px-6">
  <div class="max-w-5xl mx-auto">
    <span class="block text-[10px] font-bold tracking-[0.2em] uppercase text-[#FFD100] mb-5">From the Community</span>
    <h2 class="text-4xl md:text-5xl font-bold text-white mb-14">What people are saying</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-[#FFD100]/10">
      {[
        { quote: '[Pull a strong reaction from a waitlist subscriber, YouTube comment, or Kila Wiki reader — 2–3 sentences, specific and genuine.]', name: '[First Name, Last Initial]', role: '[Role] · [City]' },
        { quote: '[Second testimonial — ideally from someone who has attended your workshops or followed your YouTube channel and can speak to the quality of your insights.]', name: '[First Name, Last Initial]', role: '[Role] · [City]' },
        { quote: '[Third testimonial — different persona if possible, e.g. an older or more experienced investor who values the specificity.]', name: '[First Name, Last Initial]', role: '[Role] · [City]' },
      ].map((t) => (
        <div class="bg-black p-10">
          <p class="italic text-white text-base leading-relaxed mb-8">"{t.quote}"</p>
          <div class="text-xs font-bold tracking-wider text-[#FFD100]">{t.name}</div>
          <div class="text-xs text-white/40 mt-1">{t.role}</div>
        </div>
      ))}
    </div>
  </div>
</section>
<hr class="border-none h-px bg-[#FFD100]/15" />
