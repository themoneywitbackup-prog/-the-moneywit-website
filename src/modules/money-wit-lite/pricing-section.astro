---
---
<section class="bg-black py-28 px-6 text-center" id="pricing">
  <div class="max-w-3xl mx-auto">
    <span class="block text-[10px] font-bold tracking-[0.2em] uppercase text-[#FFD100] mb-5">Join Today</span>
    <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">Choose your access</h2>
    <p class="text-white/50 text-lg mb-16">Founder pricing is live now. It closes <strong class="text-[#FFD100]">[DATE]</strong>.</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-[#FFD100]/15 mb-10">
      <div class="bg-black p-12 text-left">
        <span class="block text-[10px] font-bold tracking-[0.15em] uppercase text-[#FFD100] mb-7">Monthly</span>
        <div class="text-2xl font-bold text-white mb-2">Monthly Access</div>
        <div class="text-5xl font-bold text-white">₦[X,XXX]</div>
        <div class="text-sm text-white/40 mt-2 mb-10">per month, billed monthly</div>
        <ul class="flex flex-col gap-3 mb-12">
          {['Weekly Sunday edition', 'Full onboarding series (5 emails)', 'App & platform setup guide', 'Cancel anytime'].map((f) => (
            <li class="flex items-center gap-3 text-sm text-white/60">
              <span class="text-[#FFD100] font-bold">✓</span> {f}
            </li>
          ))}
        </ul>
        <a href="#" class="block w-full text-center bg-[#FFD100] text-black py-4 text-xs font-bold tracking-[0.1em] uppercase hover:brightness-110 transition-all">
          Start Monthly →
        </a>
      </div>
      <div class="bg-[#FFD100] p-12 text-left">
        <span class="block text-[10px] font-bold tracking-[0.15em] uppercase text-black/50 mb-7">⭐ Best Value — Annual</span>
        <div class="text-2xl font-bold text-black mb-2">Annual Access</div>
        <div class="text-5xl font-bold text-black">₦[XX,XXX]</div>
        <div class="text-sm text-black/50 mt-2 mb-10">per year · save [X]% vs monthly</div>
        <ul class="flex flex-col gap-3 mb-12">
          {['Weekly Sunday edition', 'Full onboarding series (5 emails)', 'App & platform setup guide', 'Priority community access'].map((f) => (
            <li class="flex items-center gap-3 text-sm text-black/70">
              <span class="font-bold">✓</span> {f}
            </li>
          ))}
        </ul>
        <a href="#" class="block w-full text-center bg-black text-[#FFD100] py-4 text-xs font-bold tracking-[0.1em] uppercase hover:opacity-90 transition-all">
          Get Annual Access →
        </a>
      </div>
    </div>
    <p class="text-sm text-white/35">Founder pricing closes <strong class="text-[#FFD100]">[DATE]</strong>. First edition: <strong class="text-[#FFD100]">Sunday, July 6.</strong><br>This is not investment advice. You make your own financial decisions.</p>
  </div>
</section>
<hr class="border-none h-px bg-[#FFD100]/15" />
