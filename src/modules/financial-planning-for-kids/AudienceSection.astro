---
const items = [
  { icon: '👥', text: 'Ages 7–11' },
  { icon: '🤝', text: 'Parents / guardians' },
  { icon: '💻', text: 'Online learning' },
  { icon: '💰', text: 'Financial literacy' },
]
---
<section class="py-14 px-6 border-y border-white/10 bg-black">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    <div>
      <div class="flex items-center gap-4 text-[10px] font-semibold text-white/50 mb-6">
        <span class="text-[#FFBD40] text-xs pr-4 border-r border-[#FFBD40]/40">06</span>
        FOR YOUR FAMILY
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Designed for Children Ages 7–11</h2>
      <p class="text-sm text-white/60">For parents who want their children to begin developing healthy, practical money habits early.</p>
    </div>
    <div class="grid grid-cols-2 gap-6 text-sm text-white">
      {items.map((item) => (
        <span class="flex items-center gap-3">
          <span class="text-xl">{item.icon}</span>
          {item.text}
        </span>
      ))}
    </div>
  </div>
</section>
