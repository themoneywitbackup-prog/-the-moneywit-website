---
const lessons = [
  { title: 'Where does money come from?', copy: 'Help children understand that money is earned.' },
  { title: 'Dreaming big', copy: 'Explore how much money they may want to have and connect dreams with goals.' },
  { title: 'Entitlement', copy: 'Explore why children should not expect to get what they want, whenever they want it.' },
  { title: 'Basic money habits', copy: 'Introduce simple habits that help children become more intentional with money.' },
]
---
<section class="py-24 md:py-32 px-6 bg-white/5 border-y border-white/10" id="inside">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="flex items-center gap-4 text-[10px] font-semibold text-black/50 mb-6">
          <span class="text-[#FFBD40] text-xs pr-4 border-r border-[#FFBD40]/40">02</span>
          SMALL LESSONS. MEANINGFUL CONVERSATIONS.
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-black">Inside the Session</h2>
      </div>
      <p class="text-sm text-black/60 max-w-xs">Not a lecture. An interactive introduction to the world of money.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {lessons.map((lesson, i) => (
        <article class="border-t border-[#FFBD40]/30 pt-4">
          <div class="flex items-center justify-between mb-6">
            <span class="text-5xl font-bold text-[#FFBD40] leading-none">0{i + 1}</span>
            <span class="text-black/40 text-xl">↗</span>
          </div>
          <h3 class="text-lg font-medium text-black mb-3 min-h-[54px]">{lesson.title}</h3>
          <p class="text-sm text-black/55">{lesson.copy}</p>
        </article>
      ))}
    </div>
  </div>
</section>
