---
const homeWeeks = [
  'Where Money Comes From',
  'Wants, Needs & Choices',
  'Goals, Patience & Saving',
  'Putting Money Lessons Into Practice',
]
---
<section class="py-24 md:py-32 px-6 bg-white/5 border-y border-white/10" id="home-guide">
  <div class="max-w-7xl mx-auto">
    <div class="flex items-center gap-4 text-[10px] font-semibold text-black/50 mb-6">
      <span class="text-[#FFBD40] text-xs pr-4 border-r border-[#FFBD40]/40">04</span>
      THE LEARNING COMES HOME
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-14">
      <h2 class="text-4xl md:text-5xl font-bold text-black">The Lesson Doesn't End<br />When <span class="text-[#FFBD40]">Zoom Ends.</span></h2>
      <div>
        <p class="text-lg text-black leading-relaxed mb-4">The session includes a simple 4-week home guide designed to help parents continue the conversation and reinforce what their child learned.</p>
        <p class="text-sm text-black/60">More than a 40-minute session. A structure for continuing the learning at home.</p>
      </div>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      {homeWeeks.map((week, i) => (
        <div class="relative">
          <div class="w-11 h-11 rounded-full border border-[#FFBD40] flex items-center justify-center text-[#FFBD40] text-xs font-bold mb-5">0{i + 1}</div>
          <div class="text-[9px] font-bold uppercase tracking-[0.2em] text-[#FFBD40] mb-3">WEEK {i + 1}</div>
          <h3 class="text-base font-medium text-black">{week}</h3>
        </div>
      ))}
    </div>
    <div class="flex items-center gap-3 border-t border-white/10 pt-6 mt-10 text-xs text-black/50">
      <span class="text-lg">📖</span>
      <span>Included with every session. Designed for parents.</span>
    </div>
  </div>
</section>
