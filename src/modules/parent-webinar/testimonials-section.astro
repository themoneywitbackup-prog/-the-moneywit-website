---
import { Image } from 'astro:assets'
import Testimonial1 from './assets/parent-testimonial-1.jpg'
import Testimonial2 from './assets/parent-testimonial-2.jpg'
import Testimonial3 from './assets/parent-testimonial-3.jpg'

const testimonials = [Testimonial1, Testimonial2, Testimonial3]
---
<section class="bg-[#F7F6F4] py-24 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-14">
      <span class="block text-xs font-bold tracking-[0.2em] uppercase text-[#CC9200] mb-4">What Parents Are Saying</span>
      <h2 class="text-4xl md:text-5xl font-bold text-black">Real Families. Real Transformations.</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {testimonials.map((testimonial, i) => (
        <div class="aspect-[4/5] overflow-hidden">
          <Image
            src={testimonial}
            alt={`Testimonial ${i + 1}`}
            class="w-full h-full object-cover"
          />
        </div>
      ))}
    </div>
  </div>
</section>
