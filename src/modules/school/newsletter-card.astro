---
interface Props {
  title?: string
  description?: string
}

const {
  title,
  description ,
} = Astro.props
---

<section class="bg-black py-20 px-6">
  <div class="max-w-containerBrand mx-auto">
    <div
      class="bg-[#FFD100] rounded-[60px] py-16 px-6 md:px-20 flex flex-col items-center text-center"
    >
      <div class=" mb-10">
        <h2 class="rs-newsletter-title font-semibold text-black   mb-6 ">
          {title}
        </h2>
        <p class="rs-newsletter-desc text-black/80 font-normal max-w-3xl">
          {description}
        </p>
      </div>

      <form class="w-full max-w-2xl flex flex-col sm:flex-row items-center gap-4">
        <input
          type="email"
          placeholder="Enter your email"
          class="w-full bg-transparent border border-black/20 rounded-full py-4 px-8 text-black placeholder:text-black/50 outline-none focus:border-black transition-colors"
          required
        />
        <button
          type="submit"
          class="w-full sm:w-auto bg-black text-white font-bold py-4 px-10 rounded-full hover:scale-105 active:scale-95 transition-all duration-300 cursor-pointer"
        >
          Subscribe
        </button>
      </form>
    </div>
  </div>
</section>

<style lang="scss">
  @use '@/styles/fn.scss' as fn;

  .rs-newsletter-title {
    font-size: fn.useResponsiveSize(320, 1024, 28, 48);
    font-family: var(--font-family);
    line-height: 1.2;
  }

  .rs-newsletter-desc {
    font-size: fn.useResponsiveSize(320, 1024, 16, 20);
    line-height: 1.5;
  }
</style>
