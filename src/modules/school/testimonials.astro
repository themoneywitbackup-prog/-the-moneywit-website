---
import { Picture } from 'astro:assets';
import userAvatar from '../school/assets/swing.png';
import { getCollection } from 'astro:content';

interface Props {
	title?: string;
	subtitle?: string;
}

const {
	title = 'What Our Participants Say',
	subtitle = "Hear directly from the people we've helped. Real words, real experiences, from those who have learned, grown, and built confidence with us.",
} = Astro.props;

const customerTestimonialPageContent = await getCollection(
	'customerTestimonialPageCollections',
);

const customerContent = customerTestimonialPageContent.map(
	(data) => ({
		...data.data,
		rating: 5,
	}),
);
---

<section class='bg-[#F7F6F4] py-24 px-6'>
	<div class='max-w-containerBrand mx-auto'>
		<div class='text-center mb-16 max-w-3xl mx-auto'>
			<h2 class='rs-test-title font-bold text-[#1a1a1a] mb-4'>
				{title}
			</h2>
			<p class='rs-test-subtitle text-gray-600'>
				{subtitle}
			</p>
		</div>

		<div class='columns-1 md:columns-2 lg:columns-3 gap-3 space-y-3'>
			{
				customerContent.map((item) => (
					<div class='break-inside-avoid bg-[#EBEBEB] rounded-xl p-8 flex flex-col gap-3 transition-all duration-300 hover:shadow-md'>
						<div class='flex gap-1'>
							{Array.from({ length: item.rating }).map(() => (
								<svg
									width='20'
									height='20'
									fill='#ffd100'
									viewBox='0 0 24 24'>
									<path d='M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z' />
								</svg>
							))}
						</div>

						<p class='rs-test-text text-[#333] font-medium italic'>
							{item.message}
						</p>

						<div class='flex items-center gap-3 mt-auto pt-2'>
							<div class='w-10 h-10 grid place-items-center rounded-full overflow-hidden border-2 border-white/20'>
								<svg
									xmlns='http://www.w3.org/2000/svg'
									width='24'
									height='24'
									viewBox='0 0 24 24'
									fill='none'
									stroke='currentColor'
									stroke-width='2'
									stroke-linecap='round'
									stroke-linejoin='round'
									class='lucide lucide-circle-user-round-icon lucide-circle-user-round'>
									<>
										<path d='M18 20a6 6 0 0 0-12 0' />
										<circle
											cx='12'
											cy='10'
											r='4'
										/>
										<circle
											cx='12'
											cy='12'
											r='10'
										/>
									</>
								</svg>
							</div>
							<span class='font-bold text-[#1a1a1a]'>{item.name}</span>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<style lang='scss'>
	@use '@/styles/fn.scss' as fn;

	.rs-test-title {
		font-size: fn.useResponsiveSize(320, 1024, 32, 56);
		font-family: var(--font-family);
		letter-spacing: -0.02em;
		line-height: 1.1;
	}

	.rs-test-subtitle {
		font-size: fn.useResponsiveSize(320, 1024, 16, 20);
		line-height: 1.5;
	}

	.rs-test-text {
		font-size: fn.useResponsiveSize(320, 1024, 15, 18);
		line-height: 1.6;
	}
</style>
