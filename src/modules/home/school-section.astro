---
import { ArrowRight } from '@lucide/astro';
import SchoolCard from './component/school-card.astro';
import type { SvgComponent } from 'astro/types';
import type { ImageMetadata } from 'astro';
import PplIcon from './assets/ppl-icon.svg';
import GlobeIcon from './assets/globe.svg';
import Multitrack from './multitrack.astro';
import { getCollection } from 'astro:content';
const schoolsSamples = await getCollection('schoolCollection');
---

<section class='bg-black py-20 px-5 school'>
	<div class='school__container'>
		<header class='school__header'>
			<h2 class='school__title'>school</h2>

			<a
				class='school__link'
				href=''>
				<span>Find Out More</span>
				<ArrowRight />
			</a>
		</header>

		<ul class='school__list'>
			{
				schoolsSamples.slice(0, 3).map((data) => (
					<li>
						<SchoolCard
							title={data.data.title}
							description={data.data.description}
							imageUrl={data.data.preview}
							link={data.data.link}
						/>
					</li>
				))
			}
		</ul>
		<Multitrack />
	</div>
</section>

<style lang='scss'>
	@use '@/styles/fn.scss' as fn;
	.school {
		color: #fff;
		&__container {
			max-width: 75rem;
			margin-inline: auto;
		}
		&__list {
			--grid-col: 21.25rem;
			display: grid;
			margin-top: max(1.5rem, min(3.75rem, 6cqw));
			grid-template-columns: repeat(
				auto-fill,
				minmax(var(--grid-col), 1fr)
			);
			gap: 1.5rem;
		}
		&__header {
			display: flex;
			justify-content: space-between;
			gap: 0.75rem;
			align-items: center;
		}
		&__title {
			font-size: fn.useResponsiveSize(400, 900, 24, 36);
			text-transform: capitalize;
			font-weight: 500;
		}
		&__link {
			background-color: var(--primary);
			display: flex;
			color: #231e15;
			padding: 0.75rem 1.5rem;
			border-radius: 3.125rem;
			gap: 0.5rem;
			transition: background 0.4s ease;
			&:hover {
				background-color: color-mix(
					in oklab,
					var(--primary) 86%,
					transparent
				);
			}
		}
	}
</style>
