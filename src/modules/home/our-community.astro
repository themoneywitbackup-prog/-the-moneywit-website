---
import { ArrowRight } from '@lucide/astro';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import PlaceHolderImage from './assets/driver-image.png';
import type { SvgComponent } from 'astro/types';
import HandIcon from './assets/hand-icon.svg';
import MoneyIcon from './assets/money.svg';
import { Image } from 'astro-preload/components';
import { getCollection } from 'astro:content';

const communities: { communityImage: ImageMetadata; link: string }[] =
	[
		{
			communityImage: PlaceHolderImage,
			link: '/',
		},
		...Array(20).fill({
			communityImage: PlaceHolderImage,
			link: '/',
		}),
	];
const communityStats: {
	Icon: SvgComponent & ImageMetadata;
	title: string;
	description: string;
}[] = [
	{
		Icon: HandIcon,
		title: 'Over 50+ deals done',
		description: 'Deals done',
	},
	{
		Icon: MoneyIcon,
		title: '$3million+ invested',
		description: 'Financial literacy drives',
	},
];
const communitiesData = await getCollection('communityCollection');
---

<section class='our-community'>
	<div class='our-community__wrapper'>
		<header class='our-community__header'>
			<h2>Our Community</h2>
			<p>We learn and take action</p>
		</header>
		<a
			href='https://substack.com/@themoneywit/posts'
			class='our-community__cta'>
			<span>Join Us Now</span>
			<ArrowRight width={22} />
		</a>
	</div>
	<div class='our-community__wrapper--grid'>
		<ul class='scroller'>
			{
				communitiesData.map((data) => (
					<li class='our-community__community'>
						<a href={data.data.communityLink}>
							<Image
								url={`https://${data.data.previewImage}`}
								alt={''}
							/>
						</a>
					</li>
				))
			}
		</ul>
	</div>
	<div class='community-stats'>
		<div class='community-stats__container'>
			<h3 class='community-stats__title'>
				Deals done, impact made, and financial literacy drives.
			</h3>
			<ul class='community-stats__list'>
				{
					communityStats.map((data) => (
						<li class='community-stats__stats'>
							<data.Icon />
							<p class='community-stats__stats-title'>{data.title}</p>
							<p class='community-stats__stats-description'>
								{data.description}
							</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
<style lang='scss'>
	@use '@/styles/fn.scss' as fn;
	.our-community {
		padding-block: min(5rem, 10cqw);
		&__wrapper {
			display: flex;
			justify-content: space-between;
			max-width: calc(75rem + (1.25rem * 2));
			padding-inline: 1.25rem;
			margin-inline: auto;
			align-items: end;
			&--grid {
				overflow-x: scroll;
				scroll-snap-type: x proximity;
				margin-top: min(3.75rem, 6cqw);
				display: grid;
				grid-template-columns:
					minmax(24px, 1fr) repeat(2, minmax(auto, calc(1200px / 2)))
					minmax(24px, 1fr);
				scrollbar-width: 0px;
				scrollbar-width: none; /* Firefox */
				-ms-overflow-style: none;
				.scroller {
					max-width: fit-content;
					display: grid;
					grid-auto-flow: column;
					grid-auto-columns: auto;
					grid-column: 2 / -1;
					gap: 0.75rem;
					&::after {
						content: '';
						aspect-ratio: 1/1.5;
						inline-size: 20px;
					}
				}
			}
			h2 {
				font-size: fn.useResponsiveSize(400, 900, 24, 36);
				font-weight: 600;
				color: #231e15;
			}
			p {
				color: #707070;
			}
		}
		&__cta {
			background-color: var(--primary);
			transition: background 0.4s ease;
			padding: 0.75rem 1.5rem;
			border-radius: 3.125rem;
			display: flex;
			gap: 0.5rem;
			&:hover {
				background-color: oklab(from var(--primary) l a b / 0.6);
			}
		}
		&__community {
			--community-card-size: 21.875rem;
			aspect-ratio: 350/400;
			inline-size: var(--community-card-size);
			scroll-snap-align: center;
			overflow: clip;
			border-radius: 1rem;

			img {
				aspect-ratio: 350/400;
				inline-size: var(--community-card-size);
				object-fit: cover;
			}
		}
	}

	.community-stats {
		padding-inline: 1.25rem;
		margin-top: 2rem + 2.5rem;
		&__title {
			font-size: fn.useResponsiveSize(400, 900, 18, 24);
			max-width: 20ch;
		}
		&__container {
			max-width: 75rem;
			margin-inline: auto;
			display: flex;
			align-items: center;
			gap: 2rem;
			justify-content: space-between;
			flex-wrap: wrap;
		}
		&__list {
			--column-number: 2;
			--max-column: 24.5rem;
			display: grid;
			gap: 1rem;
			grid-template-columns: repeat(
				var(--column-number),
				minmax(0px, var(--max-column))
			);
			@media screen and (width <= 630px) {
				--column-number: 1;
				--max-column: 1fr;
				width: 100%;
			}
		}
		&__stats {
			background-color: #f0eeea;
			padding: 1.25rem;
			border-radius: 0.75rem;
			&-title {
				font-size: fn.useResponsiveSize(400, 900, 16, 32);
				font-weight: 700;
				color: #231e15;
			}
			&-description {
				color: #707070;
			}
		}
	}
</style>
