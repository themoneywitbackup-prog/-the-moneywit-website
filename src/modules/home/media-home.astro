---
import { ArrowRight } from '@lucide/astro';
import { getCollection } from 'astro:content';
const mediaData = await getCollection('mediaCollection');
---

<section class='media'>
	<div class='media__container'>
		<header class='media__header'>
			<h2>The Money Wit Media</h2>
			<a
				class='media__cta'
				href='/'
				>Download our Media kit
				<ArrowRight />
			</a>
		</header>

		<ul class='media__list'>
			{
				mediaData.slice(0, 3).map((data) => (
					<li>
						<div class='media-card'>
							<iframe
								class={'media-card__picture'}
								src={`https://www.youtube.com/embed/${data.data.youtubeCode}`}
								title='YouTube video player'
								frameborder='0'
								allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
								referrerpolicy='strict-origin-when-cross-origin'
								allowfullscreen
							/>
							<p class='media-card__title'>{data.data.title}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style lang='scss'>
	@use '@/styles/fn.scss' as fn;

	.feature-in {
		padding-block: 1.25rem;
		display: grid;
		grid-template-columns: 1fr 2fr;
		&__title {
			font-size: fn.useResponsiveSize(400, 900, 16, 24);
		}
	}
	.media {
		background-color: #000;
		padding-block: 5rem;
		padding-inline: 1.25rem;
		color: #fff;
		&__container {
			max-width: 75rem;
			margin-inline: auto;
		}
		&__header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			h2 {
				font-size: fn.useResponsiveSize(400, 900, 24, 36);
				font-weight: bold;
			}
		}
		&__cta {
			background-color: var(--primary);
			color: #000;
			padding: max(0.5rem, min(0.75rem, 1.7cqw))
				max(12px, min(1.5rem, 2.5cqw));
			border-radius: 3.125rem;
			display: flex;
			gap: 0.5rem;
		}
		&__list {
			display: grid;
			margin-top: max(1.25rem, min(3.75rem, 6cqw));
			gap: 1.5rem;
			grid-template-columns: repeat(
				auto-fill,
				minmax(max(13.75rem, min(18.75rem, 42cqw)), 1fr)
			);
			padding-bottom: 2rem;
		}
		&-card {
			color: #a7a7a7;

			&__picture {
				border-radius: 0.5rem;
				aspect-ratio: 394/221;
				width: 100%;
				max-width: 24.625rem;
			}
			&__title {
				margin-top: 1rem;
				font-size: fn.useResponsiveSize(300, 900, 16, 20);
			}
		}
	}
</style>
