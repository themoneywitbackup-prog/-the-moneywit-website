---
import type { ImageMetadata } from 'astro';
import placeHolderImage from './component/assets/placeholder.png';
import { Picture } from 'astro:assets';

const medias: { link: string; text: string; media: ImageMetadata }[] =
	[
		...Array(3).fill({
			media: placeHolderImage,
			link: '/',
			text: 'Money Mistakes to Be Made',
		}),
	];
---

<section class='media'>
	<div class='media__container'>
		<header class='media__header'>
			<h2>Media</h2>
			<a href='/'>Partner with Us</a>
		</header>

		<ul class='media__list'>
			{
				medias.map((data) => (
					<li class='media-card'>
						<a href={data.link}>
							<Picture
								src={data.media}
								alt={''}
								formats={['avif', 'webp']}
							/>
							<p>{data.text}</p>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style lang='scss'>
	@use '@/styles/fn.scss' as fn;

	.media {
		background-color: #000;
		padding-block: 5rem;
		padding-inline: 1.25rem;
		color: #fff;
		&__container {
			max-width: 75rem;
			margin-inline: auto;
		}
		&__header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			h2 {
				font-size: fn.useResponsiveSize(400, 900, 24, 36);
				font-weight: bold;
			}
		}
		&__list {
			display: grid;
			margin-top: max(1.25rem, min(3.75rem, 6cqw));
			gap: 1.5rem;
			grid-template-columns: repeat(
				auto-fill,
				minmax(max(13.75rem, min(18.75rem, 42cqw)), 1fr)
			);
		}
		&-card {
			color: #a7a7a7;
		}
	}
</style>
