---
---
<section class="bg-[#F7F6F4] py-24 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-14">
      <span class="block text-xs font-bold tracking-[0.2em] uppercase text-[#CC9200] mb-4">What Makes It Different</span>
      <h2 class="text-4xl md:text-5xl font-bold text-black">Faith-Based. Expert-Led. Youth-Focused.</h2>
      <p class="text-gray-500 mt-4 text-base">Interactive, story-driven, and faith-centred — designed by a financial educator who cares deeply about the next generation.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {[
        { icon: '📖', title: 'Camp Workbook & Resources', desc: 'Every attendee receives a structured workbook to capture learning and continue applying it long after camp ends.' },
        { icon: '🎮', title: 'Gamified Learning', desc: 'Knowledge quizzes, simulations, and debates that make financial education genuinely engaging for young minds.' },
        { icon: '🙏', title: 'Faith-Based Breakout Sessions', desc: 'Specialist-led sessions that integrate biblical principles into every financial topic so faith and finance are never separate.' },
        { icon: '📊', title: 'Live Simulations', desc: 'Real-world financial scenarios that give teens hands-on practice — before real money is at stake.' },
        { icon: '💬', title: 'Interactive & Story-Driven', desc: 'Not a lecture series. A collaborative, immersive experience built for teens who need to be engaged, not just taught.' },
        { icon: '📅', title: '4 Quarterly Check-Ins Post-Camp', desc: 'We don\'t teach and disappear. Your child gets four follow-up sessions after camp to ensure what they learned actually sticks and grows.', gold: true },
      ].map((feat) => (
        <div class={`p-7 border ${feat.gold ? 'bg-[#FFFBEA] border-[#FFD100]' : 'bg-white border-gray-200'}`}>
          <span class="text-3xl block mb-4">{feat.icon}</span>
          <h3 class={`text-sm font-bold mb-2 ${feat.gold ? 'text-[#7A5500]' : 'text-black'}`}>{feat.title}</h3>
          <p class={`text-sm leading-relaxed ${feat.gold ? 'text-[#8A6200]' : 'text-gray-500'}`}>{feat.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
