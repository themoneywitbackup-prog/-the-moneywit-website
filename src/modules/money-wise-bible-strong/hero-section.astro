---
import { Image } from 'astro:assets'
import MwbsBanner from './assets/mwbs-banner.jpg'
---
<section class="relative bg-black text-white pt-32 pb-24 px-6 overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 50% 20%, rgba(255,209,0,0.18) 0%, transparent 60%);"></div>
  <div class="relative z-10 max-w-5xl mx-auto mb-16">
    <figure class="rounded-xl border border-[#FFD100]/15 bg-black p-1 shadow-[0_0_120px_-30px_rgba(255,209,0,0.45)]">
      <img
        src={MwbsBanner}
        alt="The Money Wit presents Money Wise: Bible Strong Boot Camp 26"
        class="h-auto w-full rounded-lg object-contain"
      />
    </figure>
  </div>
  <div class="relative z-10 max-w-3xl mx-auto">
    <span class="block text-[#FFD100] text-xs font-bold tracking-[0.2em] uppercase mb-8">3-Day Virtual Camp · Ages 16–21 · August 12–14, 2026</span>
    <h1 class="text-6xl md:text-8xl font-bold leading-none mb-6">
      Money Wise.<br><em class="italic text-[#FFD100]">Bible Strong.</em>
    </h1>
    <p class="text-lg md:text-xl text-white/60 max-w-xl leading-relaxed mb-10 font-light">
      A 3-day virtual camp where your young one learns to make, manage, and multiply money with faith, purpose, and integrity at the core.
    </p>
    <div class="border border-[#FFD100]/20 border-l-4 border-l-[#FFD100] p-6 mb-10 max-w-lg">
      <div class="text-xs font-bold tracking-[0.2em] uppercase text-[#FFD100] mb-4">You're asking yourself:</div>
      <div class="flex flex-col gap-3">
        {[
          'How long will they rely on me financially?',
          'Will they find meaningful work and build a life of purpose?',
          'Will they avoid debt, greed, and dangerous shortcuts?',
          'Will they make money and forget God?',
        ].map((fear) => (
          <p class="text-sm text-white/60 pl-5 relative before:content-['—'] before:absolute before:left-0 before:text-[#FFD100]">{fear}</p>
        ))}
      </div>
    </div>
    <a href="#enroll" class="inline-block bg-[#FFD100] text-black px-12 py-5 text-sm font-bold tracking-[0.1em] uppercase hover:brightness-110 transition-all">
      Reserve My Child's Spot
    </a>
    <p class="text-sm text-white/35 mt-5">
      For young adults aged 16–21 · <strong class="text-[#FFD100]">₦140,000</strong> or <strong class="text-[#FFD100]">$100</strong> · Limited spots available
    </p>
  </div>
</section>
