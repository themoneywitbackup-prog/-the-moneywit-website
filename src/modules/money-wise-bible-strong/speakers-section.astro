---
import { Image } from 'astro:assets'
import Speaker1 from './assets/speaker-1.jpg'
import Speaker2 from './assets/speaker-2.jpg'
import Speaker3 from './assets/speaker-3.jpg'
import Speaker4 from './assets/speaker-4.jpg'

const speakers = [
  { name: 'Napa Onwusah', topic: 'Work-life Balance', photo: Speaker1 },
  { name: 'Tayo Osiyemi', topic: 'Entrepreneurship', photo: Speaker2 },
  { name: 'Precious Ajoonu', topic: 'Vision Boarding', photo: Speaker3 },
  { name: 'Soromfe Uzomah', topic: 'Corporate Career', photo: Speaker4 },
]
---
<section class="bg-white py-24 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-14">
      <span class="block text-xs font-bold tracking-[0.2em] uppercase text-[#CC9200] mb-4">Meet the Facilitators</span>
      <h2 class="text-4xl md:text-5xl font-bold text-black">Previous Breakout Session Hosts</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      {speakers.map((speaker) => (
        <div class="text-center">
          <div class="w-full aspect-square overflow-hidden mb-4">
            <Image
              src={speaker.photo}
              alt={speaker.name}
              class="w-full h-full object-cover"
            />
          </div>
          <div class="text-sm font-bold text-black mb-1">{speaker.name}</div>
          <div class="text-xs text-gray-400">{speaker.topic}</div>
        </div>
      ))}
    </div>
  </div>
</section>
