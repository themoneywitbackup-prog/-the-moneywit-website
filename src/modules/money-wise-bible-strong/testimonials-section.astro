    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {[1,2,3].map(() => (
        <div class="aspect-[4/5] bg-white border-2 border-dashed border-gray-300 flex flex-col items-center justify-center gap-3">
          <span class="text-3xl">📸</span>
          <span class="text-xs font-bold tracking-widest uppercase text-gray-400">Testimonial Screenshot</span>
        </div>
