---
const checklistLink = "https://oleroladele.com/high-earners-clarity-checklist/#contactform";
---

<header class="border-b border-paper/20 bg-ink text-paper">
  <div class="page-shell grid min-h-18 grid-cols-[minmax(0,1fr)_auto] items-center gap-5">
    <a href="#top" class="min-w-0" aria-label="OlerOladele home">
      <span class="display-type block truncate text-2xl leading-none">OlerOladele</span>
      <span class="mt-1 hidden truncate text-[0.65rem] uppercase tracking-[0.2em] text-paper/60 sm:block">
        High-Earners Clarity Checklist
      </span>
    </a>
    <a
      href={checklistLink}
      class="shrink-0 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-gold transition-colors hover:text-paper"
    >
      🎯 Get the Free Checklist
    </a>
  </div>
</header>
