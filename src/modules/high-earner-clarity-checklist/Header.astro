---
import { Image } from 'astro:assets'
import ProductImage from './assets/High-Earner-Checklist.png'

const checklistLink = "#contactform";
---

<section class="bg-ink text-paper">
  <div class="page-shell grid gap-12 py-16 sm:py-24 lg:grid-cols-[minmax(0,1.04fr)_minmax(20rem,0.96fr)] lg:items-center lg:gap-16 lg:py-28">
    <div class="reveal-up min-w-0">
      <p class="mb-7 text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-gold">
        High-Earners Clarity Checklist
      </p>
      <h1 class="display-type max-w-[11ch] text-[clamp(3.5rem,7vw,6.75rem)] leading-[0.9] tracking-[-0.02em]">
        Are You Earning Well But Not Seeing the Wealth to Match?
      </h1>
      <p class="mt-8 max-w-[38rem] text-lg leading-8 text-paper/78 sm:text-xl">
        Discover the 10 strategic gaps holding back even the smartest professionals and what to do instead.
      </p>
      <a
        href={checklistLink}
        class="mt-9 inline-flex min-h-14 items-center justify-center gap-3 rounded-full bg-gold px-7 py-4 text-center text-sm font-semibold text-ink transition-transform hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold"
      >
        <span aria-hidden="true">🎯</span> Get the Free Checklist
      </a>
    </div>

    <div class="reveal-up relative mx-auto w-full max-w-[32rem] [animation-delay:160ms]">
      <div class="absolute -inset-4 rounded-[2rem] border border-gold/40" aria-hidden="true"></div>
      <div class="relative overflow-hidden rounded-2xl bg-paper p-4 shadow-2xl shadow-ink">
        <img
          src={ProductImage}
          alt="The High-Earners Clarity Checklist cover"
          class="block aspect-square w-full object-cover"
          fetchpriority="high"
        />
      </div>
      <div class="absolute -bottom-5 -left-3 rounded-xl bg-gold px-5 py-4 text-ink shadow-xl sm:-left-8">
        <span class="display-type block text-3xl leading-none">10</span>
        <span class="mt-1 block text-[0.65rem] font-semibold uppercase tracking-[0.16em]">strategic gaps</span>
      </div>
    </div>
  </div>
</section>
