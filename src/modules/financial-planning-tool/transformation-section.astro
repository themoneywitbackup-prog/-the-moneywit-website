---
const before = [
  'Money managed on guesswork',
  'Numbers scattered across apps and accounts',
  'Saving whatever happens to be left',
  'Net worth you cannot state from memory',
  'Erratic discipline',
]
const after = [
  'An automated financial structure',
  'One system holding income, spending, assets and liabilities',
  'A required savings number, calculated',
  'Net worth tracked and compared year on year',
  'Monthly cash flow connected to long-term growth',
]
---
<section class="max-w-7xl mx-auto px-6 py-20 md:py-28">
  <div class="max-w-2xl">
    <span class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-black/50 mb-5">
      <span class="h-px w-6 bg-[#FFBD40]"></span>
      The transformation
    </span>
    <h2 class="text-3xl font-bold sm:text-4xl text-black">From winging it to running a system.</h2>
  </div>
  <div class="mt-12 grid gap-6 md:grid-cols-2">
    <div class="rounded-3xl border border-black/10 p-8">
      <h3 class="text-sm font-bold uppercase tracking-[0.18em] text-black/40">Before</h3>
      <ul class="mt-6 space-y-4">
        {before.map((b) => (
          <li class="flex gap-3 text-sm text-black/60">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-black/20" aria-hidden></span>
            {b}
          </li>
        ))}
      </ul>
    </div>
    <div class="rounded-3xl bg-[#0A0A0A] p-8 text-white">
      <h3 class="text-sm font-bold uppercase tracking-[0.18em] text-[#FFBD40]">After</h3>
      <ul class="mt-6 space-y-4">
        {after.map((a) => (
          <li class="flex gap-3 text-sm text-white/85">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#FFBD40]" aria-hidden></span>
            {a}
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="mt-12">
    <a href="#" class="inline-flex items-center gap-2 rounded-full bg-[#FFBD40] px-6 py-3 text-sm font-bold text-black hover:brightness-95 transition">
      Take control of your finances →
    </a>
  </div>
</section>
