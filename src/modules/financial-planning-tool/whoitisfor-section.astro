---
const audience = [
  'High-earning professionals who are cash-flow positive but not building wealth',
  'Anyone ready to start putting their finances in order',
  'People who want structure instead of another budgeting app',
  'Those working toward net worth goals who need the maths done properly',
  'Beginners, no finance degree required, a walkthrough video is included',
]
---
<section class="border-y border-black/10 bg-[#F8F7F5]">
  <div class="max-w-7xl mx-auto px-6 grid gap-12 py-20 md:py-28 lg:grid-cols-2 lg:items-start">
    <div>
      <span class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-black/50 mb-5">
        <span class="h-px w-6 bg-[#FFBD40]"></span>
        Who it is for
      </span>
      <h2 class="text-3xl font-bold sm:text-4xl text-black">Built for professionals who are done winging it.</h2>
      <p class="mt-4 leading-relaxed text-black/60">You do not need to be good with money to use this. You need to be ready to put your finances in order.</p>
    </div>
    <ul class="space-y-4">
      {audience.map((a) => (
        <li class="flex gap-4 rounded-2xl bg-white p-5 text-sm leading-relaxed text-black">
          <span class="mt-1 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-[#FFBD40] text-[11px] font-bold text-black">✓</span>
          {a}
        </li>
      ))}
    </ul>
  </div>
</section>
