---
const inside = [
  {
    name: 'Income Stream Tracker',
    detail: 'See exactly how much of your money is working for you versus how much depends on you showing up every day.',
    benefit: 'Know which naira are earned and which are owned.',
  },
  {
    name: 'Year-on-Year Comparison Dashboard',
    detail: 'Your numbers laid out side by side so the trend is impossible to ignore.',
    benefit: 'Progress becomes measurable, not a feeling.',
  },
  {
    name: 'Real Savings Number Calculator',
    detail: 'The actual number your plan requires not a round figure you hope to hit.',
    benefit: 'One target to hit each month, backed by maths.',
  },
  {
    name: 'Full Net Worth Tracker',
    detail: 'Assets, liabilities and the gap between where you are and where you need to be.',
    benefit: 'The single number that tells you if you are winning.',
  },
  {
    name: 'Wealth Goal Modeller',
    detail: 'Input your return and see what your net worth should look like by year-end.',
    benefit: 'Test decisions before you make them.',
  },
  {
    name: 'Bank Account Structure Audit',
    detail: 'The exact account structure your finances should be sitting in.',
    benefit: 'Structure that keeps discipline automatic.',
  },
]
---
<section class="max-w-7xl mx-auto px-6 py-20 md:py-28">
  <div class="max-w-2xl">
    <span class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-black/50 mb-5">
      <span class="h-px w-6 bg-[#FFBD40]"></span>
      What is inside the system
    </span>
    <h2 class="text-3xl font-bold sm:text-4xl text-black">One clear picture.</h2>
  </div>
  <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {inside.map((item, i) => (
      <article class="flex flex-col rounded-2xl border border-black/10 bg-white p-7 hover:shadow-xl transition-shadow">
        <span class="text-xs font-bold tracking-[0.2em] text-[#FFBD40]">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-3 text-lg font-bold text-black">{item.name}</h3>
        <p class="mt-3 text-sm leading-relaxed text-black/60">{item.detail}</p>
        <p class="mt-5 border-t border-black/10 pt-4 text-sm font-semibold text-black">{item.benefit}</p>
      </article>
    ))}
  </div>
  <div class="mt-12 flex flex-col sm:flex-row gap-3">
    <a href="#pricing" class="inline-flex items-center gap-2 rounded-full bg-[#FFBD40] px-6 py-3 text-sm font-bold text-black hover:brightness-95 transition">
      Get access immediately →
    </a>
    <p class="flex items-center text-xs text-black/40">Instant digital access after purchase</p>
  </div>
</section>
