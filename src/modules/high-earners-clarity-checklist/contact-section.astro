---
const checklistLink = "#contactform";
---

<section id="contactform" class="bg-ink text-paper">
  <div class="page-shell py-24 sm:py-32">
    <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
      <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-gold">05</p>
      <h2 class="display-type mt-7 max-w-[14ch] text-[clamp(3rem,7vw,6.5rem)] leading-[0.88]">
        Download Your Checklist. Get Clear. Build Wealth.
      </h2>
      <p class="mt-9 max-w-[39rem] text-xl leading-8 text-paper/78 sm:text-2xl">
        You already earn well. Let’s make sure you’re keeping — and growing your wealth with intention.
      </p>
      <div class="mt-12 w-full max-w-2xl overflow-hidden rounded-2xl border border-paper/20 bg-paper">
        <iframe
          src="https://forms.zohopublic.com/oleroladelecom/form/HighEarnerClarityChecklist/formperma/9UvbypJQ-fRqO7KR73KrY2SHyItvKDFi-PIIpphYvDA"
          title="High-Earners Clarity Checklist signup form"
          loading="lazy"
          class="block h-[640px] w-full border-0"
        ></iframe>
      </div>
      <a
        href={checklistLink}
        class="mt-10 inline-flex min-h-16 items-center justify-center gap-3 rounded-full bg-gold px-8 py-5 text-center text-sm font-semibold text-ink transition-transform hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold"
      >
        <span aria-hidden="true">🎯</span> Get the Free Checklist
      </a>
    </div>
  </div>
</section>
