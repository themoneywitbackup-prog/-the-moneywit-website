---
const checklistLink = '#contactform'
---
<section id="contactform" class="bg-[#0A0A0A] text-white">
  <div class="max-w-7xl mx-auto px-6 py-24 sm:py-32">
    <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
      <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-[#FFBD40]">05</p>
      <h2 class="mt-7 max-w-[14ch] text-[clamp(2.5rem,7vw,5.5rem)] font-bold leading-[0.88] text-white">
        Download Your Checklist. Get Clear. Build Wealth.
      </h2>
      <p class="mt-9 max-w-[39rem] text-xl leading-8 text-white/75 sm:text-2xl">
        You already earn well. Let's make sure you're keeping — and growing your wealth with intention.
      </p>
      <div class="mt-12 w-full max-w-2xl overflow-hidden rounded-2xl border border-white/20 bg-white">
        <iframe
          src="https://forms.zohopublic.com/oleroladelecom/form/HighEarnerClarityChecklist/formperma/9UvbypJQ-fRqO7KR73KrY2SHyItvKDFi-PIIpphYvDA"
          title="High-Earners Clarity Checklist signup form"
          loading="lazy"
          class="block h-[640px] w-full border-0"
        ></iframe>
      </div>
      
        href={checklistLink}
        class="mt-10 inline-flex min-h-16 items-center justify-center gap-3 rounded-full bg-[#FFBD40] px-8 py-5 text-center text-sm font-semibold text-black hover:-translate-y-1 transition-transform"
      >
        <span aria-hidden="true">🎯</span> Get the Free Checklist
      </a>
    </div>
  </div>
</section>
