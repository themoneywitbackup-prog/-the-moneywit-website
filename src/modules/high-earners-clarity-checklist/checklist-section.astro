---
const checklistLink = '#contactform'

const benefits = [
  'The 10 biggest blind spots keeping high earners from real wealth',
  'A quick self-assessment to pinpoint where you\'re stuck',
  'The difference between income and true financial freedom',
  'A simple roadmap to move from guessing to confident, strategic action',
]
---
<section class="border-t border-black/10 bg-white">
  <div class="max-w-7xl mx-auto px-6 py-20 sm:py-28">
    <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:items-end">
      <div>
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-black/50">02</p>
        <h2 class="mt-5 max-w-[14ch] text-5xl font-bold leading-[0.95] sm:text-6xl text-black">
          What's Inside the High-Earners Clarity Checklist:
        </h2>
      </div>
      <div class="h-px bg-[#FFBD40] lg:mb-2" aria-hidden="true"></div>
    </div>
    <div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-black/15 bg-black/15 sm:grid-cols-2">
      {benefits.map((benefit, index) => (
        <article class="group min-h-56 bg-white p-7 transition-colors hover:bg-[#0A0A0A] hover:text-white sm:p-9">
          <span class="text-5xl font-bold leading-none text-[#FFBD40]">{`0${index + 1}`}</span>
          <h3 class="mt-8 max-w-[18ch] text-xl font-semibold leading-snug text-black transition-colors group-hover:text-white sm:text-2xl">
            {benefit}
          </h3>
        </article>
      ))}
    </div>
    <a
      href={checklistLink}
      class="mt-10 inline-flex min-h-14 items-center justify-center gap-3 rounded-full bg-[#FFBD40] px-7 py-4 text-sm font-semibold text-black hover:-translate-y-1 transition-transform"
    >
      <span aria-hidden="true">🎯</span> Get the Free Checklist
    </a>
  </div>
</section>
