---
const features = [
	{ name: 'Weekly financial news insights', lite: true, premium: true },
	{ name: 'Access to deals', lite: true, premium: true },
	{ name: 'Deals and investment recommendations', lite: true, premium: true },
	{ name: 'Deep-dive investing guides', lite: true, premium: true },
	{ name: 'Portfolio tools/templates', lite: true, premium: true },
	{ name: 'Quarterly Masterclass invites', lite: true, premium: true },
	{ name: 'Community access', lite: true, premium: true },
	{ name: 'Monthly webinars', lite: false, premium: true },
	{ name: 'Events and meet ups', lite: false, premium: true },
	{ name: 'Real time support', lite: false, premium: true },
	{ name: 'Discounted access to Money', lite: false, premium: true },
	{ name: 'Wit School Programs', lite: false, premium: true },
	{ name: 'Deal flow personalized management', lite: false, premium: true },
	{ name: 'Real-time Community Support', lite: false, premium: true },
];
const CheckIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D9A800" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
const DashIcon = `<span class="text-gray-300">—</span>`;
interface Props {
	featureLiteLink: string;
	featurePremiumLink: string;
}
const { featureLiteLink, featurePremiumLink } = Astro.props;
---
<section class='bg-white py-16 md:py-24 px-4 sm:px-6' id='community-features'>
	<div class='max-w-5xl mx-auto'>
		<h2 class='text-2xl sm:text-3xl md:text-4xl font-bold text-center text-black mb-10 md:mb-16'>
			A Refined Exploration of Our <br class='hidden sm:block' /> Community Features
		</h2>

		<!-- MOBILE: stacked cards + compact list -->
		<div class='md:hidden space-y-6'>
			<div class='grid grid-cols-2 gap-3'>
				<div class='rounded-2xl bg-black text-white p-5'>
					<div class='flex flex-col items-center gap-3'>
						<div class='flex flex-col items-center gap-1'>
							<span class='text-xl font-bold'>Lite</span>
							<span class='text-gray-400 text-xs text-center leading-tight'>
								$6.67<span class='block text-[10px]'>/month, billed annually</span>
							</span>
						</div>
						<a href={featureLiteLink} class='w-full max-w-[160px] py-2 rounded-full text-xs font-bold text-center bg-white text-black hover:bg-gray-100 transition-all'>Join Us</a>
					</div>
					<p class='mt-3 text-center text-[10px] text-[#FFD640] font-medium'>Paid annually · $79.99/yr</p>
				</div>
				<div class='rounded-2xl bg-[#0a0a0a] text-white p-5 ring-1 ring-[#FFD640]/40'>
					<div class='flex flex-col items-center gap-3'>
						<div class='flex flex-col items-center gap-1'>
							<span class='text-xl font-bold'>Premium</span>
							<span class='text-gray-400 text-xs text-center leading-tight'>
								$30<span class='block text-[10px]'>/month, billed annually</span>
							</span>
						</div>
						<a href={featurePremiumLink} class='w-full max-w-[160px] py-2 rounded-full text-xs font-bold text-center bg-[#FFD640] text-black hover:brightness-110 transition-all'>Join Us</a>
					</div>
					<p class='mt-3 text-center text-[10px] text-[#FFD640] font-medium'>Paid annually · $360/yr</p>
				</div>
			</div>

			<div class='rounded-2xl border border-gray-200 shadow-sm overflow-hidden'>
				<div class='grid grid-cols-[minmax(0,1fr)_56px_56px] bg-gray-50 text-[11px] uppercase tracking-wider text-gray-500 font-semibold'>
					<div class='p-3'>Feature</div>
					<div class='p-3 text-center'>Lite</div>
					<div class='p-3 text-center'>Prem</div>
				</div>
				{features.map((feature) => (
					<div class='grid grid-cols-[minmax(0,1fr)_56px_56px] items-center border-t border-gray-100 text-sm text-black'>
						<div class='p-3 font-medium leading-snug'>{feature.name}</div>
						<div class='p-3 flex justify-center' set:html={feature.lite ? CheckIcon : DashIcon} />
						<div class='p-3 flex justify-center' set:html={feature.premium ? CheckIcon : DashIcon} />
					</div>
				))}
			</div>
		</div>

		<!-- DESKTOP / TABLET: full table -->
		<div class='hidden md:block overflow-x-auto rounded-2xl border border-gray-200 shadow-sm'>
			<table class='w-full text-left border-collapse'>
				<thead>
					<tr class='bg-black text-white'>
						<th class='p-6 md:p-8 text-lg font-medium border-r border-white/10 w-1/3'>Feature</th>
						<th class='p-6 md:p-8 text-center border-r border-white/10'>
							<div class='flex flex-col items-center gap-3'>
								<div class='flex flex-col items-center gap-1'>
									<span class='text-xl md:text-2xl font-bold'>Lite</span>
									<span class='text-gray-400 text-xs md:text-sm text-center leading-tight'>
										$6.67<span class='block text-[10px]'>/month, billed annually</span>
									</span>
								</div>
								<a href={featureLiteLink} class='w-full max-w-[160px] py-2 rounded-full text-xs md:text-sm font-bold text-center bg-white text-black hover:bg-gray-100 transition-all'>Join Us</a>
							</div>
						</th>
						<th class='p-6 md:p-8 text-center bg-[#0a0a0a]'>
							<div class='flex flex-col items-center gap-3'>
								<div class='flex flex-col items-center gap-1'>
									<span class='text-xl md:text-2xl font-bold'>Premium</span>
									<span class='text-gray-400 text-xs md:text-sm text-center leading-tight'>
										$30<span class='block text-[10px]'>/month, billed annually</span>
									</span>
								</div>
								<a href={featurePremiumLink} class='w-full max-w-[160px] py-2 rounded-full text-xs md:text-sm font-bold text-center bg-[#FFD640] text-black hover:brightness-110 transition-all'>Join Us</a>
							</div>
						</th>
					</tr>
					<tr class='bg-black/95 text-[#FFD640] text-xs'>
						<td class='px-6 md:px-8 pb-4 text-left font-medium uppercase tracking-wider'>Billing</td>
						<td class='px-6 pb-4 text-center border-r border-white/10'>Paid annually · $80/year</td>
						<td class='px-6 pb-4 text-center bg-[#0a0a0a]'>Paid annually · $360/year</td>
					</tr>
				</thead>
				<tbody class='text-black'>
					{features.map((feature) => (
						<tr class='border-b border-gray-200 hover:bg-gray-50 transition-colors'>
							<td class='p-5 md:px-8 text-sm md:text-base font-medium border-r border-gray-100'>{feature.name}</td>
							<td class='p-5 text-center border-r border-gray-100'>
								<div class='flex justify-center' set:html={feature.lite ? CheckIcon : DashIcon} />
							</td>
							<td class='p-5 text-center'>
								<div class='flex justify-center' set:html={feature.premium ? CheckIcon : DashIcon} />
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>

		<p class='text-center text-xs sm:text-sm text-gray-500 mt-6 px-2'>
			All community memberships are <span class='font-semibold text-black'>billed annually</span>. Monthly prices shown are for comparison only.
		</p>
	</div>
</section>
<style lang='scss'>
	table {
		font-variant-numeric: tabular-nums;
	}
</style>
