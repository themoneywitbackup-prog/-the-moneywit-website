---

interface Props {
  moneyWitFinancialHeader: string
  moneyWitFinancialDesc: string
  moneyWitFinancialButtonText: string
  moneyWitFinancialButtonLink: string
  moneyWitFinancialStepOneTitle: string
  moneyWitFinancialStepOneDesc: string
  moneyWitFinancialStepTwoTitle: string
  moneyWitFinancialStepTwoDesc: string
  moneyWitFinancialStepThreeTitle: string
  moneyWitFinancialStepThreeDesc: string
  moneyWitFinancialStepFourTitile: string
  moneyWitFinancialStepFourDesc: string
}
const {
  moneyWitFinancialHeader,
  moneyWitFinancialDesc,
  moneyWitFinancialButtonText,
  moneyWitFinancialButtonLink,
  moneyWitFinancialStepOneTitle,
  moneyWitFinancialStepOneDesc,
  moneyWitFinancialStepTwoTitle,
  moneyWitFinancialStepTwoDesc,
  moneyWitFinancialStepThreeTitle,
  moneyWitFinancialStepThreeDesc,
  moneyWitFinancialStepFourTitile,
  moneyWitFinancialStepFourDesc
} = Astro.props

const features = [
  {
    title: moneyWitFinancialStepOneTitle,
    description:  moneyWitFinancialStepOneDesc,
  },
  {
    title: moneyWitFinancialStepTwoTitle,
    description: moneyWitFinancialStepTwoDesc,
  },
  {
    title: moneyWitFinancialStepThreeTitle,
    description: moneyWitFinancialStepThreeDesc,
  },
  {
    title: moneyWitFinancialStepFourTitile,
    description: moneyWitFinancialStepFourDesc,
  },
  
]

---

<section class="bg-[#F7F7F7] py-24 px-6">
  <div class="max-w-containerBrand mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
    <div>
      <h2 class="rs-stability-title font-bold text-[#1A1A1A] mb-6 leading-tight !text-3xl">
        {moneyWitFinancialHeader}
      </h2>
      <p class="text-gray-600 text-lg mb-10 max-w-xl">
        {moneyWitFinancialDesc}
      </p>
      <a
        href={moneyWitFinancialButtonLink}
        class="inline-block bg-[#FFD100] text-black font-bold py-4 px-8 rounded-full hover:bg-[#e6bd00] transition-colors"
      >
     {moneyWitFinancialButtonText}
      </a>
    </div>

    <div class="relative pl-8">
      <div class="absolute left-0 top-2 bottom-2 w-[2px] bg-gray-300"></div>

      <div class="space-y-12">
        {
          features.map((feature) => (
            <div class="relative">
              <div class="absolute -left-[37px] top-2 w-4 h-4 rounded-full bg-gray-400 border-4 border-[#F7F7F7]" />

              <h3 class="text-xl font-bold text-[#1A1A1A] mb-2">{feature.title}</h3>
              <p class="text-gray-500 leading-relaxed">{feature.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use '@/styles/fn.scss' as fn;
  .rs-stability-title {
    font-size: fn.useResponsiveSize(320, 1024, 32, 48);
  }
</style>
