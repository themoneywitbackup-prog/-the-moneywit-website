---
interface Props {
  title?: string
  highlightText?: string
  descriptionOne: string
  descriptionTwo?: string
}

const {
  title ,
  highlightText,
  descriptionOne,
  descriptionTwo,
} = Astro.props
---

<section class="py-24 px-6 bg-[#f9f9f9]">
  <div class="max-w-containerBrand mx-auto text-center">
    <h2 class="rs-community-title font-bold text-black mb-10">
      {title}
    </h2>

    <div class="max-w-4xl mx-auto flex flex-col gap-12">
      <p class="rs-community-body text-gray-700">
        {descriptionOne}
       
      </p>

      <h3 class="rs-community-highlight font-bold text-black px-4">
        {highlightText}
      </h3>

      <p class="rs-community-body text-gray-700">
        {descriptionTwo}
      </p>
    </div>
  </div>
</section>

<style lang="scss">
  @use '@/styles/fn.scss' as fn;

  .rs-community-title {
    font-size: fn.useResponsiveSize(320, 1024, 36, 56);
    letter-spacing: -0.01em;
  }
  .rs-community-body {
    font-size: fn.useResponsiveSize(320, 1024, 16, 20);
    line-height: 1.6;
  }
  .rs-community-highlight {
    font-size: fn.useResponsiveSize(320, 1024, 22, 32);
    line-height: 1.3;
  }
</style>
