---
interface Props {
  questionOne: string
  questionTwo: string
  questionThree: string
  questionFour: string
  questionFive: string
  questionSix: string
  answerOne: string
  answerTwo: string
  answerThree: string
  answerFour: string
  answerFive: string
  answerSix: string
  faqButtonText: string
  faqButtonLink: string
}

const {
  questionOne,
  questionTwo,
  questionThree,
  questionFour,
  questionFive,
  questionSix,
  answerOne,
  answerTwo,
  answerThree,
  answerFour,
  answerFive,
  answerSix,
  faqButtonText,
  faqButtonLink
 
} = Astro.props

const faqs = [
  {
    question: questionOne,
    content: answerOne,
  },
  {
    question: questionTwo,
    content: answerTwo,
  },
  {
    question: questionThree,
    content: answerThree,
  },
  {
    question: questionFour,
    content: answerFour,
  },
  {
    question: questionFive,
    content: answerFive,
  },
  {
    question: questionSix,
    content: answerSix,
  },
]
---

<section class="bg-black text-white py-24 px-6 min-h-screen">
  <div class="max-w-containerBrand mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24">
    <div class="lg:sticky lg:top-24 h-fit">
      <h2 class="rs-faq-title font-bold mb-8 leading-tight">
        Questions?<br />
        We Have Answers
      </h2>
      <button
        class="bg-[#FFD640] text-black font-bold py-4 px-10 rounded-full hover:scale-105 transition-transform"
      >
      <a href={faqButtonLink}> {faqButtonText}</a>
       
      </button>
    </div>

    <div class="flex flex-col gap-4" id="faq-list">
      {
        faqs.map((faq: { question: string; content: string }) => (
          <div class="faq-item bg-[#111111] rounded-2xl overflow-hidden border border-white/5 transition-all duration-300">
            <button
              class="faq-toggle w-full p-6 md:p-8 flex justify-between items-center text-left group cursor-pointer"
              aria-expanded="false"
            >
              <span class="text-lg md:text-xl font-medium pr-8">{faq.question}</span>

              <div class="relative w-6 h-6 flex items-center justify-center shrink-0">
                <span class="icon-v absolute w-0.5 h-full bg-white/40 group-hover:bg-white transition-all duration-300" />
                <span class="absolute w-full h-0.5 bg-white/40 group-hover:bg-white transition-all duration-300" />
              </div>
            </button>

            <div class="faq-content max-h-0 overflow-hidden opacity-0 transition-all duration-500 ease-in-out">
              <div class="p-6 md:p-8 pt-0 text-white leading-relaxed border-t border-white/5 mt-2">
                {faq.content ? (
                  <p class="mt-4">{faq.content}</p>
                ) : (
                  <p class="mt-4">{faq.content}</p>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const toggles = document.querySelectorAll('.faq-toggle')

  toggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const content = toggle.nextElementSibling as HTMLElement
      const iconV = toggle.querySelector('.icon-v')
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true'

      document.querySelectorAll('.faq-toggle').forEach((other) => {
        if (other !== toggle) {
          other.setAttribute('aria-expanded', 'false')
          ;(other.nextElementSibling as HTMLElement).style.maxHeight = '0px'
          ;(other.nextElementSibling as HTMLElement).style.opacity = '0'
          other.querySelector('.icon-v')?.classList.remove('rotate-90', 'opacity-0')
        }
      })

      if (isExpanded) {
        toggle.setAttribute('aria-expanded', 'false')
        content.style.maxHeight = '0px'
        content.style.opacity = '0'
        iconV?.classList.remove('rotate-90', 'opacity-0')
      } else {
        toggle.setAttribute('aria-expanded', 'true')
        content.style.maxHeight = content.scrollHeight + 'px'
        content.style.opacity = '1'
        iconV?.classList.add('rotate-90', 'opacity-0')
      }
    })
  })
</script>

<style lang="scss">
  @use '@/styles/fn.scss' as fn;

  .rs-faq-title {
    font-size: fn.useResponsiveSize(320, 1024, 40, 64);
    letter-spacing: -0.02em;
  }

  .faq-item[aria-expanded='true'] {
    background-color: #1a1a1a;
  }

  .icon-v {
    transform-origin: center;
  }
</style>
