---
interface Props {
  title?: string
  highlightText?: string
}

const {
  title = 'Community Overview',
  highlightText = 'Our community bridges the gap between understanding financial principles and executing strategic actions.',
} = Astro.props
---

<section class="py-24 px-6 bg-[#f9f9f9]">
  <div class="max-w-containerBrand mx-auto text-center">
    <h2 class="rs-community-title font-bold text-black mb-10">
      {title}
    </h2>

    <div class="max-w-4xl mx-auto flex flex-col gap-12">
      <p class="rs-community-body text-gray-700">
        The Money Wit is the action arm; where your financial education transforms into wealth
        building opportunities. The Money Wit empowers you to actively deploy capital into vetted
        investment opportunities including startups, mutual funds, Eurobonds, Tekedia, and curated
        deals across emerging markets.
      </p>

      <h3 class="rs-community-highlight font-bold text-black px-4">
        {highlightText}
      </h3>

      <p class="rs-community-body text-gray-700">
        You don't just learn about wealth building; you participate in it through collective
        intelligence, shared due diligence, and access to institutional-grade opportunities to
        facilitate wealth building.
      </p>
    </div>
  </div>
</section>

<style lang="scss">
  @use '@/styles/fn.scss' as fn;

  .rs-community-title {
    font-size: fn.useResponsiveSize(320, 1024, 36, 56);
    letter-spacing: -0.01em;
  }

  .rs-community-body {
    font-size: fn.useResponsiveSize(320, 1024, 16, 20);
    line-height: 1.6;
  }

  .rs-community-highlight {
    font-size: fn.useResponsiveSize(320, 1024, 22, 32);
    line-height: 1.3;
  }
</style>
