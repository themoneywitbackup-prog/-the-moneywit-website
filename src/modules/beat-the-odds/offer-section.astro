---
const features = [
  '3 hours live workshop with Oler Oladele, CFA',
  'Financial current state assessment',
  'Gap analysis where you are vs where you need to be',
  'Inflation-proofing framework',
  'Investment clarity session',
  'Planning tools and templates included',
  'Live Q&A with Oler',
  'Post-workshop resources and support',
]
const PAY_FULL_USD_LINK = 'https://forms.zohopublic.com/oleroladelecom/form/BeattheOddsWaitlist/formperma/aTAolI6VJoEI5Ed7unSTJNhp9MrlX_VUMd_HR5sFzqc'
const PAY_FULL_NGN_LINK = 'https://forms.zohopublic.com/oleroladelecom/form/BeattheOddsWaitlist/formperma/aTAolI6VJoEI5Ed7unSTJNhp9MrlX_VUMd_HR5sFzqc'
const PAY_INSTALLMENT_USD_LINK = 'https://forms.zohopublic.com/oleroladelecom/form/BeattheOddsWaitlist/formperma/aTAolI6VJoEI5Ed7unSTJNhp9MrlX_VUMd_HR5sFzqc'
const PAY_INSTALLMENT_NGN_LINK = 'https://forms.zohopublic.com/oleroladelecom/form/BeattheOddsWaitlist/formperma/aTAolI6VJoEI5Ed7unSTJNhp9MrlX_VUMd_HR5sFzqc'
---
<section id="offer" class="py-20 md:py-28 px-6 bg-white">
  <div class="max-w-7xl mx-auto">
    <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-black/50 mb-8">
      <span class="h-px w-6 bg-[#FFBD40]"></span>
      Reserve Your Seat - Cohort 5
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_0.85fr] gap-10 rounded-3xl border border-black/10 p-8 md:p-12 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-black mb-3">Beat the Odds Workshop</h2>
        <p class="text-black/60 text-sm mb-8">A live, 3 hour personal finance and investment workshop. Limited cohort. Led by Oler Oladele, CFA.</p>
        <ul class="space-y-3 text-sm">
          {features.map((f) => (
            <li class="flex gap-3 text-black">
              <span class="text-[#FFBD40] mt-0.5 flex-shrink-0">✓</span>
              {f}
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl bg-[#0A0A0A] p-8 text-white">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/50 mb-3">Workshop investment</p>
        <p class="text-3xl font-extrabold text-[#FFBD40] mb-1">NGN 300,000 or USD 200</p>
        <p class="text-sm text-white/50 mb-8">USD checkout also available · Limited spots per cohort</p>
        <div class="flex flex-col gap-3">
          <!-- Pay in Full -->
          <div>
            <button
              id="btn-full"
              type="button"
              class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#FFBD40] px-6 py-3.5 text-sm font-bold text-black hover:brightness-95 transition"
            >
              Pay in Full — Reserve My Seat
            </button>
            <div id="panel-full" class="overflow-hidden max-h-0 opacity-0 mt-0 transition-all duration-300 ease-out">
              <div class="flex flex-col gap-2 mt-3">
                <a
                  href={PAY_FULL_USD_LINK}
                  class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-white/10 px-5 py-2.5 text-xs font-semibold text-white hover:bg-white/20 transition"
                >
                  Pay in USD →
                </a>
                <a
                  href={PAY_FULL_NGN_LINK}
                  class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-white/10 px-5 py-2.5 text-xs font-semibold text-white hover:bg-white/20 transition"
                >
                  Pay in NGN →
                </a>
              </div>
            </div>
          </div>
          <!-- Pay in Instalments -->
          <div>
            <button
              id="btn-installment"
              type="button"
              class="inline-flex w-full flex-col items-center justify-center rounded-full border border-[#FFBD40]/40 px-6 py-3.5 text-sm font-bold text-[#FFBD40] hover:bg-[#FFBD40]/10 transition"
            >
              <span>Pay in 2 Instalments — Reserve My Seat</span>
              <span class="text-[10px] font-medium text-[#FFBD40]/70 mt-0.5">₦150,000 now / ₦150,000 due Oct 31</span>
            </button>
            <div id="panel-installment" class="overflow-hidden max-h-0 opacity-0 mt-0 transition-all duration-300 ease-out">
              <div class="flex flex-col gap-2 mt-3">
                <a
                  href={PAY_INSTALLMENT_USD_LINK}
                  class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-white/20 px-5 py-2.5 text-xs font-semibold text-white hover:bg-white/10 transition"
                >
                  Pay in USD →
                </a>
                <a
                  href={PAY_INSTALLMENT_NGN_LINK}
                  class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-white/20 px-5 py-2.5 text-xs font-semibold text-white hover:bg-white/10 transition"
                >
                  Pay in NGN →
                </a>
              </div>
            </div>
          </div>
        </div>
        <p class="text-xs text-white/30 text-center mt-4">Cohort 5.</p>
      </div>
    </div>
  </div>
</section>
<script is:inline>
  function togglePanel(btnId, panelId) {
    const btn = document.getElementById(btnId)
    const panel = document.getElementById(panelId)
    const otherPanelId = panelId === 'panel-full' ? 'panel-installment' : 'panel-full'
    const otherPanel = document.getElementById(otherPanelId)
    const isOpen = panel.style.maxHeight && panel.style.maxHeight !== '0px'
    // Close other panel first
    otherPanel.style.maxHeight = '0px'
    otherPanel.style.opacity = '0'
    otherPanel.style.marginTop = '0'
    // Toggle clicked panel
    if (isOpen) {
      panel.style.maxHeight = '0px'
      panel.style.opacity = '0'
      panel.style.marginTop = '0'
    } else {
      panel.style.maxHeight = '160px'
      panel.style.opacity = '1'
      panel.style.marginTop = '12px'
    }
  }
  document.getElementById('btn-full')?.addEventListener('click', () => {
    togglePanel('btn-full', 'panel-full')
  })
  document.getElementById('btn-installment')?.addEventListener('click', () => {
    togglePanel('btn-installment', 'panel-installment')
  })
</script>
