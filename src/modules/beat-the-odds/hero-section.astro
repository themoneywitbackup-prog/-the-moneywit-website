---
import { Image } from 'astro:assets'
import ProductImage from './assets/beat-the-odds.jpg'
---
<section class="relative overflow-hidden" style="background: linear-gradient(135deg, #0A0A0A 0%, #1a1a0a 50%, #0a0a0a 100%);">
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 70% 50%, rgba(255,189,64,0.12) 0%, transparent 60%);"></div>
  <div class="max-w-7xl mx-auto px-6 relative">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 py-16 md:py-24 items-center">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-[#FFBD40] mb-6">
          <span class="h-px w-6 bg-[#FFBD40]"></span>
          The Money Wit · Live Workshop
        </div>
        <div class="inline-flex items-center gap-2 mb-6">
          <span
            class="inline-flex items-center gap-2 rounded-full border border-[#FFBD40]/50 bg-[#FFBD40]/10 px-4 py-2 text-xs font-bold text-[#FFBD40] tracking-wide"
            style="box-shadow: 0 0 12px rgba(255,189,64,0.35), 0 0 32px rgba(255,189,64,0.15);"
          >
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#FFBD40] opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-[#FFBD40]"></span>
            </span>
            Cohort 5 · Limited Seats · Live, Saturday November 14, 2026
          </span>
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-white leading-[1.05] tracking-tight mb-6">
          Beat The
          <span class="text-[#FFBD40]"> Odds</span>
        </h1>
        <p class="text-lg text-white/70 leading-relaxed mb-6 max-w-lg">
          Hope is not a strategy and right now, that's what your finances are running on. Beat The Odds is the live workshop where high-income professionals stop gambling with their family's future and leave, in one session with a real plan: the clarity, tools, and structure to protect what you've built and finally put your money to work.
        </p>
        <div class="flex flex-wrap gap-4 mb-6 text-sm text-white/60">
          {['Live Workshop', 'Limited Seats', 'CFA-Led', 'Tools Included'].map((tag) => (
            <span class="flex items-center gap-1.5">
              <span class="text-[#FFBD40]">✦</span> {tag}
            </span>
          ))}
        </div>
        <div class="flex flex-col sm:flex-row gap-3 mb-6">
          <a href="#offer" class="inline-flex items-center justify-center gap-2 rounded-full bg-[#FFBD40] px-6 py-3.5 text-sm font-bold text-black hover:brightness-95 transition">
            Reserve Your Seat →
          </a>
          <a href="#curriculum" class="inline-flex items-center justify-center gap-2 rounded-full border border-[#FFBD40]/40 px-6 py-3.5 text-sm font-bold text-[#FFBD40] hover:bg-[#FFBD40]/10 transition">
            See what's inside
          </a>
        </div>
        <p class="text-xs text-white/40">Investment: NGN 300,000 ($200) · Pay in full or 2 installments · Led by Oler Oladele, CFA</p>

        <!-- Countdown -->
        <div class="mt-6" data-countdown="2026-11-14T00:00:00+01:00">
          <p class="text-xs font-medium uppercase tracking-[0.2em] text-white/50 mb-3">
            Cohort 5 starts in
          </p>
          <div
            class="inline-flex items-center gap-2 rounded-2xl border border-[#FFBD40]/30 bg-[#FFBD40]/5 p-3"
            style="box-shadow: 0 0 12px rgba(255,189,64,0.35), 0 0 32px rgba(255,189,64,0.15);"
          >
            <div class="flex items-center">
              <div class="flex flex-col items-center min-w-[52px] px-1">
                <span class="text-lg md:text-xl font-bold text-[#FFBD40]" data-unit="days">00</span>
                <span class="text-[10px] uppercase tracking-wide text-white/40">Days</span>
              </div>
              <span class="text-[#FFBD40]/30 text-sm font-bold px-1">:</span>
            </div>
            <div class="flex items-center">
              <div class="flex flex-col items-center min-w-[52px] px-1">
                <span class="text-lg md:text-xl font-bold text-[#FFBD40]" data-unit="hours">00</span>
                <span class="text-[10px] uppercase tracking-wide text-white/40">Hours</span>
              </div>
              <span class="text-[#FFBD40]/30 text-sm font-bold px-1">:</span>
            </div>
            <div class="flex items-center">
              <div class="flex flex-col items-center min-w-[52px] px-1">
                <span class="text-lg md:text-xl font-bold text-[#FFBD40]" data-unit="minutes">00</span>
                <span class="text-[10px] uppercase tracking-wide text-white/40">Minutes</span>
              </div>
              <span class="text-[#FFBD40]/30 text-sm font-bold px-1">:</span>
            </div>
            <div class="flex items-center">
              <div class="flex flex-col items-center min-w-[52px] px-1">
                <span class="text-lg md:text-xl font-bold text-[#FFBD40]" data-unit="seconds">00</span>
                <span class="text-[10px] uppercase tracking-wide text-white/40">Seconds</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="relative">
        <div class="absolute inset-0 translate-y-6 rounded-3xl blur-2xl" style="background: rgba(255,189,64,0.2);"></div>
        <Image
          src={ProductImage}
          alt="Beat the Odds workshop by The Money Wit — Oler Oladele, CFA"
          class="relative w-full rounded-3xl border border-white/10 shadow-2xl object-cover"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<script>
  function pad(n: number) {
    return n.toString().padStart(2, "0");
  }

  document.querySelectorAll<HTMLElement>("[data-countdown]").forEach((root) => {
    const targetDate = new Date(root.dataset.countdown ?? "");
    const daysEl = root.querySelector<HTMLElement>('[data-unit="days"]');
    const hoursEl = root.querySelector<HTMLElement>('[data-unit="hours"]');
    const minutesEl = root.querySelector<HTMLElement>('[data-unit="minutes"]');
    const secondsEl = root.querySelector<HTMLElement>('[data-unit="seconds"]');

    const tick = () => {
      const distance = targetDate.getTime() - Date.now();

      if (distance <= 0) {
        root.style.display = "none";
        clearInterval(interval);
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance / (1000 * 60 * 60)) % 24);
      const minutes = Math.floor((distance / (1000 * 60)) % 60);
      const seconds = Math.floor((distance / 1000) % 60);

      if (daysEl) daysEl.textContent = pad(days);
      if (hoursEl) hoursEl.textContent = pad(hours);
      if (minutesEl) minutesEl.textContent = pad(minutes);
      if (secondsEl) secondsEl.textContent = pad(seconds);
    };

    tick();
    const interval = setInterval(tick, 1000);
  });
</script>
