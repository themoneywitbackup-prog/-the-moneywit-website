---
const sessions = [
  { n: '01', title: 'Your Personal Finance Review', time: 'Key Area 1', body: 'We will access where you are now, identify mindset and action gaps and provide you with actionable steps to improve your situation.', outcome: 'A complete, honest x-ray of your money.' },
  { n: '02', title: 'The Goal Setting', time: 'Key Area 2', body: 'Clearly define your financial goals and set a roadmap to achieve them.', outcome: 'A clear goal and the levers to achieve it.' },
  { n: '03', title: 'Curating Your Financial Plan', time: 'Key Area 3', body: 'Develop a tailored blueprint to guide you from where you are to where you ought to be.', outcome: 'A protection plan built for the current economy.' },
  { n: '04', title: 'Risk Mitigation', time: 'Key Area 4', body: 'Learn how to avoid the common mistakes that can derail your financial progress.', outcome: 'Avoid costly mistakes and protect your progress.' },
  { n: '05', title: 'Investment Strategy Creation', time: 'Key Area 5', body: 'Develop a personalized investment plan, learn the best options for you and how to start making your money work harder.', outcome: 'Know where and how to invest your money.' },
  { n: '06', title: 'Vision Board Session', time: 'Key Area 6', body: 'A fun, inspiring activity to visually map your financial goals and future making your dreams feel tangible and attainable.', outcome: 'Turn your financial dreams into clear, achievable goals.' },
]
---
<section id="curriculum" class="py-20 md:py-28 px-6 bg-white">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-black/50 mb-4">
          <span class="h-px w-6 bg-[#FFBD40]"></span>
          The workshop curriculum
        </div>
        <h2 class="text-3xl md:text-5xl font-bold text-black tracking-tight leading-[1.1]">Six sessions. One complete financial rebuild.</h2>
      </div>
      <div class="rounded-xl border border-black/10 bg-[#F9F8F5] px-5 py-4 text-sm flex-shrink-0">
        <div class="text-xs uppercase tracking-widest text-black/40 mb-1">Format</div>
        <div class="font-bold text-black">Live · 3 Hours Session</div>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {sessions.map((s) => (
        <article class="group relative overflow-hidden rounded-2xl border border-black/10 bg-[#F9F8F5] p-7 hover:border-[#FFBD40]/50 transition-colors">
          <div class="flex items-start justify-between gap-4 mb-4">
            <div>
              <div class="text-xs font-bold uppercase tracking-[0.2em] text-[#FFBD40] mb-2">{s.time} · {s.n}</div>
              <h3 class="text-xl font-bold text-black leading-tight">{s.title}</h3>
            </div>
          </div>
          <p class="text-sm text-black/60 leading-relaxed mb-4">{s.body}</p>
          <div class="flex items-center gap-2 text-sm font-semibold text-black border-t border-black/10 pt-4">
            <span class="text-[#FFBD40]">→</span>
            {s.outcome}
          </div>
          <div class="pointer-events-none absolute -right-4 -top-4 font-bold text-[6rem] leading-none text-[#FFBD40]/5 group-hover:text-[#FFBD40]/10 transition-colors">
            {s.n}
          </div>
        </article>
      ))}
    </div>
    <div class="mt-10">
      <a href="#offer" class="inline-flex items-center gap-2 rounded-full bg-[#FFBD40] px-6 py-3 text-sm font-bold text-black hover:brightness-95 transition">
        Join the Waitlist →
      </a>
    </div>
  </div>
</section>
