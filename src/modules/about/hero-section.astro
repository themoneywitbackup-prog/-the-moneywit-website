---
import { Picture } from 'astro:assets'
import AboutHeroImg from './assets/About-hero.png'

interface Props {
  title: string
  
}

const { title } = Astro.props
---
<section class="about-hero relative w-full overflow-hidden flex items-center justify-center">
  <div class="absolute inset-0 z-0">
    <Picture
      src={AboutHeroImg}
      alt="About hero background"
      layout="full-width"
      widths={[640, 768, 1024, 1280, 1600, 1920, 2560]}
      sizes="100vw"
      formats={['avif', 'webp']}
      class="w-full h-full object-cover"
    />

    <div class="absolute inset-0 bg-black/50"></div>
  </div>

  <div class="max-w-containerBrand m-auto relative z-10 px-6 text-center">
    <h1 class="rs-about-title font-bold !text-[60px] text-white leading-tight max-w-md">
      {title}
    </h1>
  </div>
</section>

<style lang="scss">
  @use '@/styles/fn.scss' as fn;

  .about-hero {
    min-height: max(20rem, min(35rem, 60dvh));
  }
  .rs-about-title {
    font-size: fn.useResponsiveSize(320, 1024, 36, 72);
    
    letter-spacing: -0.02em;
  }
  picture,
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
