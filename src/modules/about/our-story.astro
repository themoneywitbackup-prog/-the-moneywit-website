---
interface Props {
  
  ourStory: string
}

const {

  ourStory
} = Astro.props
---

<section class="our-story bg-black text-white py-24 px-6">
  <div class="max-w-containerBrand m-auto grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-4">
    <div class="md:col-span-4">
      <h2 class="rs-story-title font-bold leading-tight">
      Our Story
      </h2>
    </div>

    <div class="md:col-start-6 md:col-span-7 flex flex-col gap-8">
       <p class="rs-story-text text-gray-300">{ourStory}</p>
    </div>
  </div>
</section>

<style lang="scss">
  @use '@/styles/fn.scss' as fn;

  .rs-story-title {
    font-size: fn.useResponsiveSize(320, 1024, 36, 64);
    font-family: bold;
    letter-spacing: -0.02em;
  }

  .rs-story-text {
    font-size: fn.useResponsiveSize(320, 1024, 16, 18);
    line-height: 1.7;
    font-family: var(--font-family);
    font-weight: 400;
  }
</style>
