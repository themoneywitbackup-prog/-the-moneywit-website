---
import { Image } from 'astro:assets'
import PhilosophyImg from './assets/Philosophy.webp'

interface Props {
 ourPhilosophyDesc:string
 ourPhilosophyTitle:string
}

const {  ourPhilosophyDesc,ourPhilosophyTitle } = Astro.props
---
<section class="our-philosophy py-24 px-6 bg-black">
  <div
    class="max-w-containerBrand m-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
  >
    <div class="flex flex-col gap-8">
      <h2 class="rs-philosophy-title font-bold text-[#F7F6F4]">
      {ourPhilosophyTitle}
      </h2>

      <div class="rs-philosophy-text flex flex-col gap-6 text-[#F7F6F4]">
        {ourPhilosophyDesc}
      </div>
    </div>

    <div class="relative">
      <Image
        src={PhilosophyImg}
        alt="Financial professional writing on a board"
        class="rounded-2xl w-full h-auto object-cover shadow-sm"
      />
    </div>
  </div>
</section>

<style lang="scss">
  @use '@/styles/fn.scss' as fn;

  .rs-philosophy-title {
    font-size: fn.useResponsiveSize(320, 1024, 32, 56);
    font-family: bold;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .rs-philosophy-text {
    font-size: fn.useResponsiveSize(320, 1024, 15, 18);
    line-height: 1.5;
    letter-spacing: -0.02em;
    font-weight: 400;
    font-family: var(--font-family);
  }
  h2 {
  }

  @media screen and (max-width: 1023px) {
    .our-philosophy {
      text-align: center;
      .rs-philosophy-title {
        margin-inline: auto;
      }
    }
  }
</style>
