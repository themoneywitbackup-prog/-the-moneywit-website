---
import ServiceWrapper from '@/components/ui/ServiceWrapper.astro'
import ServiceCard from '@/components/Landing-page/ServiceCard.astro'
import beatImage from './assets/beat.webp'

const tabs = [
  'Tools & Resources',
  'Online Programs',
  'Workshops',
  'Bespoke Programs',
  'Paid Programs',
]
const description = "We'll give you the clarity and tools to take control of your financial future"
---

<ServiceWrapper
  title="How We Can Serve You"
  subtitle="Flexible, self-paced learning that covers the foundations of money management, saving, and investing."
  tabs={tabs}
  defaultTab="Online Programs"
>
  <ServiceCard
    category="Tools & Resources"
    title="Budgeting Template"
    description="A comprehensive tool to track your monthly spending and savings."
    image={beatImage}
  />
  <ServiceCard
    category="Tools & Resources"
    title="Investment Calculator"
    description="Calculate your projected returns based on various asset classes."
    image={beatImage}
  />

  <ServiceCard
    category="Online Programs"
    title="BEAT THE ODDS"
    description={description}
    image={beatImage}
  />
  <ServiceCard
    category="Online Programs"
    title="Money Wise Bible Strong"
    description={description}
    image={beatImage}
    hasWaitlist={true}
    timer="5D:22H:20M"
  />

  <ServiceCard
    category="Workshops"
    title="Retirement Planning"
    description="Hands-on workshop for building a sustainable retirement nest egg."
    image={beatImage}
    hasWaitlist={true}
    timer="12D:04H:30M"
  />
  <ServiceCard
    category="Workshops"
    title="Tax Optimization"
    description="Learn legal strategies to minimize your tax liabilities annually."
    image={beatImage}
  />

  <ServiceCard
    category="Bespoke Programs"
    title="Corporate Literacy"
    description="Customized financial wellness programs for your organization's employees."
    image={beatImage}
  />
  <ServiceCard
    category="Bespoke Programs"
    title="Private Coaching"
    description="One-on-one tailored financial strategy sessions with our lead experts."
    image={beatImage}
  />

  <ServiceCard
    category="Paid Programs"
    title="The Masterclass"
    description="Our premium deep-dive into advanced wealth creation strategies."
    image={beatImage}
    hasWaitlist={true}
    timer="45D:12H:00M"
  />
  <ServiceCard
    category="Paid Programs"
    title="Portfolio Management"
    description="A specialized program on managing high-net-worth investment portfolios."
    image={beatImage}
  />
</ServiceWrapper>
