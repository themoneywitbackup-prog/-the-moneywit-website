---
import StatGrid from '@/components/ui/StatGrid.astro';
import PeopleIcon from '@/components/assets/icons/pepicons-pop_people.svg'
import ContinentsIcon from '@/components/assets/icons/Group.svg'
import GlobeIcon from '@/components/assets/icons/material-symbols_globe.svg'


const individualStats = [
  {
    target: 300,
    suffix: "+",
    label: "Individuals Trained",
     icon: PeopleIcon,
  },
  {
    target: 4,
    label: "Continents",
   icon: ContinentsIcon,
  },
  {
    target: 10,
    label: "Countries Impacted", 
   icon: GlobeIcon,
  }
];

interface Props {
  trackRecordHeader: string
  trackRecordDesc: string
}

const { trackRecordHeader, trackRecordDesc } = Astro.props
---

<StatGrid 
  title={trackRecordHeader}
  description={trackRecordDesc}
  stats={individualStats}
/>