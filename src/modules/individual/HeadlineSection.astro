---
import Bannerwrapper from '@/components/ui/BannerWrapper.astro';

interface Props {
  heading?: string;
  subtext?: string;
  buttonText?: string;
  headlineUrl?: string;
}

const {
  heading,
  subtext,
  buttonText,
  headlineUrl,
} = Astro.props;
---

<Bannerwrapper
  bgColor="bg-[#F7F6F4]" 
  headingColor="text-[#1a1a1a]"
  subtextColor="text-[#4a4a4a]"
  buttonClass="bg-[#FFD341] text-black rounded-4xl hover:bg-yellow-400 py-3"
  href={headlineUrl}
  ariaLabel="Join the Money Wit Club"
>
  <div slot="heading">{heading}</div>
  <div slot="subtext">{subtext}</div>
  <div slot="button-text">{buttonText}</div>
</Bannerwrapper>