---
interface Props {
  heading: string
  descOne: string
  descTwo: string
  descThree: string
  descFour: string
}

const { heading, descOne, descTwo, descThree, descFour } = Astro.props
---

<section class="bg-white py-20 px-6">
  <div class="max-w-4xl mx-auto flex flex-col items-center">
    <h2 class="rs-wealth-title font-bold text-[#1a1a1a] mb-8 text-center">
      {heading}
    </h2>

    <div class="space-y-8 text-[#1a1a1a]">
      <p class="rs-wealth-body text-gray-700">
        {descOne}
      </p>

      <p class="rs-wealth-bold font-bold leading-tight">
        {descTwo}
      </p>

      <div class="flex gap-6 border-l-2 border-black pl-6 py-2">
        <blockquote class="rs-wealth-quote italic text-gray-800">
          {descThree}
        </blockquote>
      </div>

      <p class="rs-wealth-body text-gray-700">
        {descFour}
      </p>
    </div>
  </div>
</section>

<style lang="scss">
  @use '@/styles/fn.scss' as fn;

  .rs-wealth-title {
    font-size: fn.useResponsiveSize(320, 1024, 32, 48);
    font-family: var(--font-family);
  }

  .rs-wealth-body {
    font-size: fn.useResponsiveSize(320, 1024, 16, 18);
    line-height: 1.6;
  }

  .rs-wealth-bold {
    font-size: fn.useResponsiveSize(320, 1024, 18, 24);
  }
  .rs-wealth-quote {
    font-size: fn.useResponsiveSize(320, 1024, 18, 22);
    line-height: 1.4;
  }
</style>
