---
import ArrowFowardIcon from '@/modules/community/assets/icon/arrow_forward.svg';
import { getCollection } from 'astro:content';
const mediaData = await getCollection('mediaCollection');
---

<section class='bg-black text-white py-24 px-6'>
	<div class='max-w-containerBrand mx-auto'>
		<div
			class='flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12'>
			<div class='max-w-2xl'>
				<h2 class='rs-news-title font-semibold mb-4'>
					Global News Review
				</h2>
				<p class='rs-news-description text-gray-400 leading-relaxed'>
					Catch up on our most-watched videos. From quick tips to in-depth
					conversations designed to give you clarity on money.
				</p>
			</div>

			<a
				href='https://www.youtube.com/@oleroladele'
				target='_blank'
				class='inline-flex items-center justify-center gap-2 bg-white text-black font-medium py-3 px-8 rounded-full hover:bg-gray-200 transition-all duration-300 whitespace-nowrap text-center'>
				See All Videos
				<ArrowFowardIcon />
			</a>
		</div>

		<div class='grid grid-cols-1 md:grid-cols-3 gap-8'>
			{
				mediaData.map((video) => (
					<div class='flex flex-col gap-5 group'>
						<div class='aspect-video w-full rounded-2xl overflow-hidden bg-[#111111] border border-white/5 transition-transform duration-300 group-hover:scale-[1.02]'>
							<iframe
								width='100%'
								height='100%'
								src={`https://www.youtube.com/embed/${video.data.youtubeCode}`}
								title={video.data.title}
								allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
								referrerpolicy='strict-origin-when-cross-origin'
								allowfullscreen
								class='opacity-90 group-hover:opacity-100 transition-opacity'
							/>
						</div>
						<h3 class='text-lg font-medium text-[#A7A7A7] leading-snug px-1 line-clamp-2 group-hover:text-white transition-colors text-[20px]'>
							{video.data.title}
						</h3>
					</div>
				))
			}
		</div>
	</div>
</section>

<style lang='scss'>
	@use '@/styles/fn.scss' as fn;
	.rs-news-title {
		font-size: fn.useResponsiveSize(320, 1024, 32, 48);
		letter-spacing: -0.02em;
	}
	.rs-news-description {
		font-size: fn.useResponsiveSize(320, 1024, 16, 18);
	}
	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
