---
import StatGrid from '@/components/ui/StatGrid.astro';
import PeopleIcon from '@/components/assets/icons/pepicons-pop_people.svg'
import ContinentsIcon from '@/components/assets/icons/Group.svg'
import GlobeIcon from '@/components/assets/icons/mdi_company.svg'

const stats = [
	{
		target: 100,
		suffix: 'K+',
		label: 'Individuals Reached',
		icon: PeopleIcon,
	},
	{
		target: 50,
		suffix: '+',
		label: 'Companies Served',
		icon: GlobeIcon,
		
	},
	{
		target: 7,
		suffix: '+',
		label: 'Countries Impacted',
		 icon: ContinentsIcon,
		
	},
];
---

<StatGrid
  title="Our Impact"
  description="We've reached over 100,000 individuals, served 50+ companies, and impacted lives across 20+ countries. Our commitment to financial education is making a global difference."
  stats={stats}
  bgColor="bg-black"
  cardColor="bg-[#111111] border border-white/5"
  titleColor="text-white"
  descColor="text-gray-400"
  numColor="text-[#FFD100]"
  labelColor="text-gray-400"
/>
