---
const steps = [
  { n: '01', t: 'Pay once', d: 'One-time payment of NGN 20,000. USD checkout also available.' },
  { n: '02', t: 'Get instant access', d: 'Watch the 60-minute masterclass immediately after payment on any device.' },
  { n: '03', t: 'Follow the post-session guide', d: 'Receive an email with the accounts to open and introductions to relevant investment partners.' },
  { n: '04', t: 'Make your first move', d: 'Go from knowing nothing to having a clear investment plan and a first action in one session.' },
]
---
<section class="border-y border-black/10 bg-[#F8F7F5]">
  <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
    <div class="max-w-2xl">
      <span class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-black/50 mb-5">
        <span class="h-px w-6 bg-[#FFBD40]"></span>
        How it works
      </span>
      <h2 class="text-3xl font-bold sm:text-4xl text-black">From zero to invested — in one sitting.</h2>
    </div>
    <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s) => (
        <li class="rounded-2xl bg-white p-7">
          <span class="text-3xl font-extrabold text-[#FFBD40]">{s.n}</span>
          <h3 class="mt-4 text-base font-bold text-black">{s.t}</h3>
          <p class="mt-2 text-sm leading-relaxed text-black/60">{s.d}</p>
        </li>
      ))}
    </ol>
    <div class="mt-12">
      <a href="#offer" class="inline-flex items-center gap-2 rounded-full bg-[#FFBD40] px-6 py-3 text-sm font-bold text-black hover:brightness-95 transition">
        Start today →
      </a>
    </div>
  </div>
</section>
