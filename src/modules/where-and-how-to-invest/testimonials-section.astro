---
const testimonials = [
  {
    quote: 'This session completely changed how I think about money. I finally understood what investing actually means and took my first steps the very next week.',
    name: 'Adaeze O.',
    role: 'Marketing Professional · Lagos',
  },
  {
    quote: 'I have attended many finance webinars but none as clear and actionable as this. Oler breaks it down in a way that makes you feel like you can actually do it.',
    name: 'Tunde A.',
    role: 'Engineer · Abuja',
  },
  {
    quote: 'After this session I opened my first investment account. The post-session guide was incredibly helpful. Worth every naira.',
    name: 'Chioma N.',
    role: 'Nurse · Port Harcourt',
  },
]
---
<section class="bg-[#0A0A0A] text-white">
  <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
    <span class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-[#FFBD40] mb-10">
      <span class="h-px w-6 bg-[#FFBD40]"></span>
      What students are saying
    </span>
    <div class="grid gap-6 md:grid-cols-3">
      {testimonials.map((t) => (
        <figure class="flex h-full flex-col rounded-2xl border border-white/10 bg-white/5 p-7">
          <span class="font-bold text-4xl leading-none text-[#FFBD40]" aria-hidden>"</span>
          <blockquote class="mt-3 flex-1 text-sm leading-relaxed text-white/85">{t.quote}</blockquote>
          <figcaption class="mt-6 border-t border-white/10 pt-4 text-sm">
            <span class="font-bold text-white">{t.name}</span>
            <span class="block text-xs text-white/50">{t.role}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
