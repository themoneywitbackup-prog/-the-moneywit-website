---
const features = [
  '60-minute expert-led masterclass',
  'Instant access after payment',
  'Watch on any device, forever',
  'Post-session guide with accounts to open',
  'Introductions to relevant investment partners',
  'No prior knowledge required',
]
---
<section class="bg-[#0A0A0A] text-white">
  <div class="max-w-7xl mx-auto px-6 grid gap-12 py-20 md:py-28 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
    <div>
      <span class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-white/50 mb-5">
        <span class="h-px w-6 bg-[#FFBD40]"></span>
        The offer
      </span>
      <h2 class="text-3xl font-bold sm:text-4xl text-white">Where and How to Invest</h2>
      <ul class="mt-7 space-y-3 text-sm">
        {features.map((f) => (
          <li class="flex gap-3 text-white">
            <span class="mt-1 text-[#FFBD40]">✓</span>
            {f}
          </li>
        ))}
      </ul>
    </div>
    <div class="rounded-2xl bg-[#0A0A0A] p-8 text-white">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/50">One-time payment</p>
      <p class="mt-3 text-4xl font-extrabold text-[#FFBD40]">NGN 20,000</p>
      <p class="mt-2 text-sm text-white/50">USD checkout also available.</p>
      <div class="mt-7 flex flex-col gap-3">
        <a href="https://zohosecurepay.com/checkout/no3obkp-jngjy2kamp7ff/Where-and-how-to-invest-masterclass" class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#FFBD40] px-6 py-3.5 text-sm font-bold text-black hover:brightness-95 transition">
          Get the masterclass (NGN) →
        </a>
        <a href="https://zohosecurepay.com/checkout/2kugmvg-8lngy0yp469zu/Where-and-How-To-Invest" class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-[#FFBD40]/40 px-6 py-3.5 text-sm font-bold text-[#FFBD40] hover:bg-[#FFBD40]/10 transition">
          Pay in USD →
        </a>
      </div>
    </div>
  </div>
</section>
