---
const inside = [
  {
    n: '01',
    name: 'The Investment Landscape',
    detail: 'A clear map of where your money can go — Nigerian equities, Treasury Bills, fixed income, money market, real estate and global assets.',
    benefit: 'Know your options before you choose.',
  },
  {
    n: '02',
    name: 'How to Evaluate Any Opportunity',
    detail: 'The framework professionals use to assess risk, return, liquidity and fit — applied to the opportunities available to Nigerian investors.',
    benefit: 'Never invest on gut feel again.',
  },
  {
    n: '03',
    name: 'How to Avoid Costly Mistakes',
    detail: 'The traps that quietly destroy wealth before it is built — and how to recognise and sidestep them from day one.',
    benefit: 'Protect what you have while you grow.',
  },
  {
    n: '04',
    name: 'Building Your First Portfolio',
    detail: 'Practical steps to go from zero to your first diversified portfolio — no matter how much you are starting with.',
    benefit: 'A plan you can act on immediately.',
  },
  {
    n: '05',
    name: 'The Nigerian Investment Landscape',
    detail: 'A clear picture of the options available to you as a Nigerian investor — locally and internationally.',
    benefit: 'Invest with context, not confusion.',
  },
  {
    n: '06',
    name: 'Your Next Steps',
    detail: 'After the session you receive an email with the exact accounts to open and introductions to relevant partners.',
    benefit: 'Leave with a clear first action.',
  },
]
---
<section class="max-w-7xl mx-auto px-6 py-20 md:py-28">
  <div class="max-w-2xl">
    <span class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-black/50 mb-5">
      <span class="h-px w-6 bg-[#FFBD40]"></span>
      What is inside the masterclass
    </span>
    <h2 class="text-3xl font-bold sm:text-4xl text-black">Six chapters. One clear path to investing with confidence.</h2>
  </div>
  <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {inside.map((item) => (
      <article class="flex flex-col rounded-2xl border border-black/10 bg-white p-7 hover:shadow-xl transition-shadow">
        <span class="text-xs font-bold tracking-[0.2em] text-[#FFBD40]">{item.n}</span>
        <h3 class="mt-3 text-lg font-bold text-black">{item.name}</h3>
        <p class="mt-3 text-sm leading-relaxed text-black/60">{item.detail}</p>
        <p class="mt-5 border-t border-black/10 pt-4 text-sm font-semibold text-black">{item.benefit}</p>
      </article>
    ))}
  </div>
  <div class="mt-12 flex flex-col sm:flex-row gap-3">
    <a href="#" class="inline-flex items-center gap-2 rounded-full bg-[#FFBD40] px-6 py-3 text-sm font-bold text-black hover:brightness-95 transition">
      Get the full masterclass →
    </a>
    <p class="flex items-center text-xs text-black/40">Instant access after payment</p>
  </div>
</section>
