---
const steps = [
  { n: '1', t: 'Get instant access', b: 'One-time payment. Watch on any device, forever.' },
  { n: '2', t: 'Run the diagnostic', b: 'Two focused hours with worksheets you fill in as you go.' },
  { n: '3', t: 'Act on what you find', b: 'Leave with a concrete list of what to fix first.' },
]
---
<section class="border-b border-black/10 py-20 md:py-28">
  <div class="max-w-7xl mx-auto px-6">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-[#FFBD40]">How it works</span>
      <h2 class="mt-3 font-bold text-4xl tracking-tight md:text-5xl text-black">
        Simple. Structured.
        <span class="italic text-black/40"> Done in one sitting.</span>
      </h2>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {steps.map((s) => (
        <div class="rounded-2xl border border-black/10 bg-white p-7">
          <div class="grid h-10 w-10 place-items-center rounded-full bg-[#FFBD40] font-black text-black text-lg">
            {s.n}
          </div>
          <h3 class="mt-5 text-lg font-bold text-black">{s.t}</h3>
          <p class="mt-2 text-sm text-black/60">{s.b}</p>
        </div>
      ))}
    </div>
  </div>
</section>
