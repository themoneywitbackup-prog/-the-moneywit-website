<section class="relative overflow-hidden border-b border-black/10 bg-gradient-to-b from-[#FFFBF0] to-white">
  <div class="max-w-7xl mx-auto px-6 relative pt-10 pb-16 md:pt-14 md:pb-24">
    <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-[#FFBD40]/40 bg-[#FFBD40]/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-[#FFBD40]">
        ✦ A Diagnostic Course · Presented by Oler Oladele, CFA
      </span>

      <h1 class="mt-6 font-bold text-[clamp(2.75rem,7vw,5.5rem)] leading-[0.95] tracking-tight text-black">
