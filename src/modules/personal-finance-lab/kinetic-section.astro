---
<section class="bg-black border-y border-white/10 overflow-hidden py-3 md:py-4">
  <div class="flex gap-6 whitespace-nowrap" style="animation: reel 35s linear infinite;">
    {['Diagnose', 'Bridge', 'Secure', 'Compound', 'Repeat', 'Diagnose', 'Bridge', 'Secure', 'Compound', 'Repeat', 'Diagnose', 'Bridge', 'Secure', 'Compound', 'Repeat', 'Diagnose', 'Bridge', 'Secure', 'Compound', 'Repeat'].map((w, i) => (
      <span class="flex items-center gap-6 font-bold tracking-tight" style={`font-size: clamp(1.1rem, 2.2vw, 1.75rem); color: ${i % 2 === 0 ? '#FFD100' : 'transparent'}; -webkit-text-stroke: ${i % 2 === 0 ? '0' : '1px #FFD100'};`}>
        {w}
        <span class="text-white/20">✦</span>
      </span>
    ))}
  </div>
</section>
<style>
  @keyframes reel {
    from { transform: translateX(0); }
    to { transform: translateX(-25%); }
  }
</style>
