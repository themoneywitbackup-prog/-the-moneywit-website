---
const items = [
  { n: '01', h: 'Diagnose', p: 'Get an honest x-ray of your current financial state; income, spending, debt, assets.' },
  { n: '02', h: 'Bridge', p: 'Identify the exact gaps between where you are and the future you want.' },
  { n: '03', h: 'Secure', p: 'Install the systems and habits that make progress compound automatically.' },
]
---
<section class="bg-black text-white px-6 py-28 md:py-36">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-px bg-white/10">
    {items.map((it) => (
      <div class="bg-black p-8 md:p-12 h-full">
        <div class="font-bold mb-6 text-transparent" style={`font-size: clamp(3.5rem, 6vw, 5rem); -webkit-text-stroke: 1px #FFD100; line-height: 1;`}>
          {it.n}
        </div>
        <div class="text-2xl md:text-3xl font-bold text-[#FFD100] mb-4">{it.h}</div>
        <p class="text-white/60 leading-relaxed">{it.p}</p>
      </div>
    ))}
  </div>
</section>
