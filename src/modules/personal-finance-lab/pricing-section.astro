---
const features = [
  '4 modules · 16 lessons',
  'Diagnostic worksheets included',
  'Instant, lifetime access',
  'Watch on any device, forever',
]
---
<section id="pricing" class="border-b border-black/10 py-20 md:py-28">
  <div class="max-w-7xl mx-auto px-6">
    <div class="mx-auto max-w-3xl text-center">
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-[#FFBD40]">Get started</span>
      <h2 class="mt-3 font-bold text-4xl tracking-tight md:text-5xl text-black">
        Make <span class="italic text-[#FFBD40]">intentional</span> financial decisions.
      </h2>
      <p class="mt-4 text-lg text-black/60">One time payment. Lifetime access. No subscription.</p>
    </div>

    <div class="mx-auto mt-12 max-w-lg overflow-hidden rounded-3xl border border-[#FFBD40]/40 bg-white shadow-[0_0_60px_rgba(255,189,64,0.15)]">
      <div class="border-b border-black/10 bg-[#FFBD40] p-6 text-center text-black">
        <div class="text-xs font-semibold uppercase tracking-[0.2em]">Personal Finance Lab</div>
        <div class="mt-2 text-sm font-semibold">One-time payment · Lifetime access</div>
      </div>
      <div class="p-8">
        <div class="flex items-baseline justify-center gap-3">
          <span class="font-bold text-4xl text-black">₦150,000</span>
          <span class="text-black/40">or</span>
          <span class="font-bold text-4xl text-black">$100</span>
        </div>
        <ul class="mt-8 space-y-3 text-sm">
          {features.map((f) => (
            <li class="flex items-center gap-2 text-black">
              <span class="text-[#FFBD40]">✅</span>
              {f}
            </li>
          ))}
        </ul>
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a href="https://zohosecurepay.com/checkout/q2l2ho2-izpi530oxgl1m/Personal-Finance-Lab" class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#FFBD40] px-6 py-3.5 text-base font-semibold text-black transition hover:brightness-95">
            Pay in Naira →
          </a>
          <a href="https://zohosecurepay.com/checkout/nzv09a3-ylf27z7snwx7o/PERSONAL-FINANCE-LAB--USD" class="inline-flex w-full items-center justify-center gap-2 rounded-full border-2 border-black px-6 py-3.5 text-base font-semibold text-black transition hover:bg-black hover:text-[#FFBD40]">
            Pay in USD →
          </a>
        </div>
        <p class="mt-4 text-center text-xs text-black/40">Built and taught by Oler Oladele, CFA.</p>
      </div>
    </div>
  </div>
</section>
