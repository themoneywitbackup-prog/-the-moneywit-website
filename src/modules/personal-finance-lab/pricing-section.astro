---
---
<section id="pricing" class="relative bg-black text-white px-6 py-28 md:py-40 overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(circle at 50% 100%, rgba(255,209,0,0.18), transparent 60%);"></div>
  <div class="relative max-w-4xl mx-auto text-center">
    <div class="text-xs tracking-[0.4em] uppercase font-bold text-[#FFD100] mb-8">Get Started Now</div>
    <h2 class="font-bold leading-[0.95] tracking-tight mb-14" style="font-size: clamp(2.5rem, 8vw, 6.5rem);">
      Roll <em class="font-medium text-[#FFD100]">credits</em> on financial confusion.
    </h2>

    <div class="rounded-lg border-2 border-[#FFD100] p-8 md:p-12 bg-[#FFD100]/4">
      <div class="text-[10px] tracking-[0.4em] uppercase text-[#FFD100] mb-3">Personal Finance Lab</div>
      <div class="text-white/60 text-sm mb-6">One time payment · Lifetime access</div>
      <div class="flex items-baseline justify-center gap-3 mb-10">
        <div class="text-6xl md:text-3xl font-bold">₦150,000</div>
        <div class="text-6xl md:text-3xl font-bold">or $100</div>
      </div>

      <ul class="text-left max-w-md mx-auto space-y-3 mb-10 text-white/75 text-sm">
        {[
          '4 modules · 16 lessons,
          'Diagnostic worksheets included',
          'Instant, lifetime access',
          'Watch on any device, forever',
        ].map((f) => (
          <li class="flex items-center gap-3">
            <span class="w-5 h-5 rounded-full flex items-center justify-center text-[11px] font-bold flex-shrink-0 bg-[#FFD100] text-black">✓</span>
            {f}
          </li>
        ))}
      </ul>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-md mx-auto">
        <a href="https://zohosecurepay.com/checkout/cv0v4a8-17p1zx54l3yai/Personal-Finance-Lab" class="text-center py-4 text-xs tracking-[0.2em] uppercase font-bold rounded-md hover:opacity-90 transition bg-[#FFD100] text-black">
          Pay in Naira
        </a>
        <a href="https://zohosecurepay.com/checkout/epw3y1o-khuimsm5qfxmy/PERSONAL-FINANCE-LAB--USD" class="text-center py-4 text-xs tracking-[0.2em] uppercase font-bold rounded-md border-2 border-[#FFD100] text-[#FFD100] transition hover:bg-white/5">
          Pay in USD
        </a>
      </div>
    </div>
  </div>
</section>
