---
import { ChevronDownIcon } from '@lucide/astro';
interface Props {
	link: string;
	text: string;
	children?: { link: string; text: string }[];
}
const { link, text, children } = Astro.props;
console.log('🪲 🪲 link-comp.astro:9 🪲 link:', link);
const { pathname } = Astro.url;
console.log('🪲 🪲 link-comp.astro:11 🪲 pathname:', pathname);
const activePath = link === pathname;
console.log('🪲 🪲 link-comp.astro:13 🪲 activePath:', activePath);
---

{
	children ?
		<span class='text-white flex nav-item'>
			<span>{text}</span> <ChevronDownIcon />
			<div class='nav-item__drop-down'>
				<ul class='nav-item__list'>
					{children.map((data) => (
						<li>
							<a href={data.link}>{data.text}</a>
						</li>
					))}
				</ul>
			</div>
		</span>
	:	<a
			class={activePath ? 'text-brandYellow' : 'text-white'}
			href={link}>
			{text}
		</a>
}

<style lang='scss'>
	.nav-item {
		position: relative;
		&__drop-down {
			display: none;
		}
		&__list {
			display: grid;
			padding-inline: 0.875rem;
			padding-block: 0.75rem;
			border-radius: 0.25rem;
			opacity: 1;
			gap: 1rem;
			transition: opacity 0.4s ease;
			background-color: #121212;
			li {
				&:hover {
					color: var(--primary);
				}
			}
			@starting-style {
				opacity: 0;
			}
		}
		&:hover {
			.nav-item__drop-down {
				position: absolute;
				padding-top: 2rem;
				display: block;
			}
		}
	}
</style>
