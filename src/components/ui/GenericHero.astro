---
import { Image } from 'astro:assets'

interface Props {
  heading?: string
  subheading?: string
  buttonText?: string
  buttonHref?: string
  image?: ImageMetadata 
  imageAlt?: string
  headingClass?: string
  subheadingClass?: string

}

const {
  heading ,
  subheading ,
  buttonText ,
  buttonHref,
  image,
  imageAlt = 'Financial literacy hero image',
  headingClass = '',
  subheadingClass = '', 
  
} = Astro.props
---

<section class="bg-black text-white pt-20 pb-16 px-6 flex flex-col items-center overflow-hidden">
  <div class="max-w-containerBrand w-full mx-auto flex flex-col items-center text-center">
    <div class="flex flex-col items-center gap-2 md:gap-4 mb-10">
      <h1 class:list={[
        "rs-hero-heading font-bold tracking-tight max-w-5xl leading-tight",
        headingClass
      ]}>
        {heading}
      </h1>

      <h2 class:list={[
        "rs-hero-subheading tracking-tight",
        subheadingClass
      ]}>
        {subheading}
      </h2>
    </div>
    
    <a
      href={buttonHref}
      class="rs-hero-button bg-[#FFD60A] hover:bg-[#ffdf40] text-black font-bold py-3.5 px-10 rounded-full transition-all duration-300 hover:scale-105 active:scale-95 mb-10"
    >
      {buttonText}
    </a>

    {image && (
      <div class="w-full max-w-5xl px-2 md:px-0">
        <div class="relative rounded-[10px] overflow-hidden shadow-2xl border border-white/5">
          <Image src={image} alt={imageAlt} class="w-full h-auto object-cover" loading="eager" />
        </div>
      </div>
    )}
  </div>
</section>

<style lang="scss">
  @use '@/styles/fn.scss' as fn;

  .rs-hero-heading {
    font-size: fn.useResponsiveSize(320, 1024, 36, 64);
    font-family: var(--font-family);
  }

  .rs-hero-subheading {
    font-size: fn.useResponsiveSize(320, 1024, 28, 52);
    font-family: var(--font-family);
  }

  .rs-hero-button {
    font-size: fn.useResponsiveSize(320, 1024, 16, 18);
  }
</style>