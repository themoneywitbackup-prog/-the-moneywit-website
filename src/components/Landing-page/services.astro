---
import ServiceWrapper from '@/components/ui/ServiceWrapper.astro'
import ServiceCard from '@/components/Landing-page/ServiceCard.astro'
import { getCollection } from 'astro:content'

interface Props {
  title?: string
  subtitle?: string
  defaultTab?: string
}

const {
  title = 'How We Can Serve You',
  subtitle = 'Flexible, self-paced learning that covers the foundations of money management, saving, and investing.',
  defaultTab,
} = Astro.props

const programmes = await getCollection('programCollection')

const allCategories = programmes.flatMap((data) => data.data.category || [])
const uniqueCategories = [...new Set(allCategories)].filter((cat) => cat && cat.trim() !== '')

const effectiveDefaultTab = defaultTab || uniqueCategories[0] || 'Programs'
---

<ServiceWrapper
  title={title}
  subtitle={subtitle}
  tabs={uniqueCategories}
  defaultTab={effectiveDefaultTab}
>
  {
    programmes.map((program) => {
      return program.data.category?.map((category) => (
        <ServiceCard
          category={category}
          title={program.data.title}
          description={program.data.description}
          image={program.data.previewImage}
        />
      ))
    })
  }
</ServiceWrapper>
