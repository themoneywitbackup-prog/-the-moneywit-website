---
import BrandLogo from './assets/brand.svg';
import LinkComp from './nav-comp/link-comp.astro';

import {
	Cross,
	CrossIcon,
	Hamburger,
	HamburgerIcon,
	MenuIcon,
	X,
} from '@lucide/astro';
const navigation: {
	link: string;
	text: string;
	clickable?: true;
	children?: { link: string; text: string }[];
}[] = [
	{ link: '/', text: 'Home' },
	{
		link: '/what-we-do',
		text: 'What We Do',
		clickable: true,
		children: [
			{ link: '/school', text: 'School' },

			{ link: '/media', text: 'Media' },
			{ link: '/community', text: 'Community' },
		],
	},
	{
		link: '/our-programs',
		text: 'Our Programs',
		children: [
			{ link: '/individual', text: 'Individual' },
			{ link: '/corporate', text: 'Corporate' },
		],
	},
	{ link: 'https://shop.themoneywit.africa/', text: 'Shop' },
	{
		link:
			'https://open.substack.com/pub/oleroladele?r=23819j&utm_medium=iosBlog',
		text: 'Blog',
	},
	{ link: '/about', text: 'About Us' },
	{
		link: 'https://oleroladele.zohorecruit.com/jobs/Careers',
		text: 'Careers',
	},
];
---

<nav class='bg-black py-2.5 px-6 nav'>
	<div
		class='max-w-containerBrand m-auto flex justify-between items-center gap-2 nav__container'>
		<a
			title='home page'
			href='/'>
			<BrandLogo />
		</a>
		<div class='gap-8 rs-font-link flex z-50'>
			{
				navigation.map((data) => {
					return <LinkComp {...data} />;
				})
			}
		</div>
		<a
			class='nav__cta py-3 px-6 bg-white align-middle rounded-full rs-font'
			href='/corporate'>
			For Organisations
		</a>
		<button
			popovertarget='mobile-menu'
			class='mobile-icon text-white'>
			<MenuIcon />
		</button>
	</div>
</nav>

<div
	popover
	id='mobile-menu'
	class='mobile-menu'>
	<div class='mobile-menu__header'>
		<button
			popovertarget='mobile-menu'
			type='button'>
			<X />
		</button>
	</div>
	<ul class='grid gap-1'>
		{
			navigation.map((data) => {
				return data.children ?
						<li>
							<details>
								<summary>{data.text}</summary>
								<div class='details'>
									<ul>
										{data.children.map((data) => (
											<li>
												<a href={data.link}>{data.text}</a>
											</li>
										))}
									</ul>
								</div>
							</details>
						</li>
					:	<li>
							<a href={data.link}>{data.text}</a>
						</li>;
			})
		}
	</ul>
</div>
<style lang='scss'>
	@use '@/styles/fn.scss' as fn;
	.mobile-menu {
		--color-bg: oklab(from #ffd341 l a b);
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100dvh;
		background-color: var(--color-bg);
		padding: 1.25rem;
		&__header {
			display: flex;
			justify-content: end;
		}
	}
	.rs-font {
		font-size: fn.useResponsiveSize(320, 1024, 12, 16);
		font-family: var(--font-family);
	}
	.rs-font-link {
		font-size: fn.useResponsiveSize(320, 1024, 12, 14);
	}
	@media screen and (width > 872px) {
		.mobile-icon {
			display: none;
		}
	}
	@media screen and (width <= 872px) {
		.rs-font-link {
			display: none;
		}
		.nav__cta {
			display: none;
		}
	}
</style>
