---
import BaseLayout from '@/layout/base-layout.astro'
import AboutHero from '@/modules/about/hero-section.astro'
import OurPhilosophy from '@/modules/about/our-philosophy.astro'
import OurStory from '@/modules/about/our-story.astro'
import OurValues from '@/modules/about/our-values.astro'
import { getCollection } from 'astro:content'
const aboutPageContent = await getCollection("aboutPageCollections")
const pageContent = aboutPageContent[0].data
const {smarterMoneyHeroText, ourStory, ourPhilosophyDesc,ourPhilosophyTitle} = pageContent

---

<BaseLayout>
  <AboutHero title={smarterMoneyHeroText} />
  <OurStory ourStory={ourStory} />
  <OurValues/>
  <OurPhilosophy ourPhilosophyDesc={ourPhilosophyDesc} ourPhilosophyTitle={ourPhilosophyTitle}/>
</BaseLayout>
