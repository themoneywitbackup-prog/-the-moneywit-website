---
import { Image } from 'astro-preload/components';
import Countdown from './count-down';

interface Props {
	title: string;
	description: string;
	image: string;
	timeAndDate: Date;
	paymentLink: string;
	paymentLink2: string;
}
const {
	description,
	image,
	timeAndDate,
	title,
	paymentLink,
	paymentLink2,
} = Astro.props;
---

<section class='campaign-hero'>
	<div class='campaign-hero__container'>
		<div class='campaign-hero__content'>
			<header class='campaign-hero__header'>
				<h1>
					{title}
				</h1>
				<p>{description}</p>
			</header>
			<Countdown
				targetDate={timeAndDate.toDateString()}
				client:load
			/>
			<div class='campaign-hero__cta'>
				<a
					href={paymentLink}
					class='campaign-hero__primary'>
					{paymentLink}
				</a>
				<a
					href={paymentLink2}
					class='campaign-hero__secondary'>
					{paymentLink2}
				</a>
			</div>
		</div>
	</div>
	<div class='campaign-hero__image'>
		<Image
			url={`https://${image}`}
			alt={''}
		/>
	</div>
</section>
<style lang='scss' is:global>
	@use '@/styles/fn.scss' as fn;
	.campaign-hero {
		display: grid;
		grid: [stack] 1fr / [stack] 1fr;
		isolation: isolate;
		place-items: center;
		&__cta {
			display: flex;
			margin-top: 2rem;
			justify-content: center;
			gap: 1rem;
			& * {
				padding: 0.75rem 1.5rem;
				border-radius: 3.125rem;
			}
		}
		&__primary {
			background-color: #000000;
		}
		&__secondary {
			background-color: #fff;
			color: #000000;
		}
		&__ &__container {
			padding-inline: 1.25rem;
			padding-block: 2rem;
		}
		&__header {
			text-align: center;
			display: grid;
			gap: 1.5rem;
			h1 {
				font-size: fn.useResponsiveSize(380, 700, 24, 64);
				max-width: 20ch;
				line-height: 1;
				font-weight: bold;
				text-wrap: balance;
			}
			p {
				font-size: fn.useResponsiveSize(380, 700, 16, 18);
				max-width: 55ch;
				margin-inline: auto;
			}
		}
		& > * {
			grid-area: stack;
		}
		&__content {
			color: #fff;
		}
		&__image {
			--aspect-ratio: 2/1;
			position: relative;
			z-index: -3;
			container-type: inline-size;
			width: 100%;
			min-height: 50dvw;

			&::before {
				content: '';
				background-color: oklab(from #000 l a b / 0.5);
				position: absolute;
				inset: 0;
				z-index: 2;
			}
			img {
				z-index: 1;
				position: absolute;
				width: 100%;
				height: 100%;
				// aspect-ratio: var(--aspect-ratio);
				object-fit: cover;
				// @container (width <=600px) {
				// 	--aspect-ratio: 1/1.5;
				// }
			}
		}
	}
	.countdown {
		--column-size: 4;
		border: 1px solid #fff;
		display: grid;
		grid-template-columns: repeat(var(--column-size), 1fr);
		place-items: center;
		padding-inline: fn.useResponsiveSize(380, 700, 12, 24);
		padding-block: fn.useResponsiveSize(380, 700, 12, 16);
		max-width: 25rem;
		margin-inline: auto;
		border-radius: 0.75rem;
		margin-top: 2rem;

		@media (width <=600px) {
			--column-size: 2;
			max-width: 12.5rem;
		}

		& > span {
			display: grid;
			place-items: center;
			font-size: fn.useResponsiveSize(380, 700, 16, 32);
			width: 100%;
			padding-inline: fn.useResponsiveSize(380, 900, 8, 20);

			& + span {
				border-left: 1px solid #fff;
				@media (width <=600px) {
					border-left: none;
				}
			}

			p {
				font-size: fn.useResponsiveSize(380, 700, 12, 16);
				font-weight: 300;
				text-transform: capitalize;
			}
		}
	}
</style>
