---
import { Image } from 'astro-preload/components';
import Countdown from './count-down';

interface Props {
	title: string;
	description: string;
	image: string;
	timeAndDate: Date;
}
const { description, image, timeAndDate, title } = Astro.props;
---

<section class='campaign-hero'>
	<div class='campaign-hero__container'>
		<div class='campaign-hero__content'>
			<header class='campaign-hero__header'>
				<h1>
					{title}
				</h1>
				<p>{description}</p>
			</header>
			<Countdown client:load />
		</div>
	</div>
	<div class='campaign-hero__image'>
		<Image
			url={`https://${image}`}
			alt={''}
		/>
	</div>
</section>
<style lang='scss' is:global>
	@use '@/styles/fn.scss' as fn;
	.campaign-hero {
		display: grid;
		grid: [stack] 1fr / [stack] 1fr;
		isolation: isolate;
		place-items: center;
		&__container {
			padding-inline: 1.25rem;
		}
		&__header {
			text-align: center;
			display: grid;
			gap: 1.5rem;
			h1 {
				font-size: fn.useResponsiveSize(380, 700, 24, 64);
				max-width: 20ch;
				line-height: 1;
				font-weight: bold;
				text-wrap: balance;
			}
			p {
				font-size: fn.useResponsiveSize(380, 700, 16, 18);
				max-width: 55ch;
				margin-inline: auto;
			}
		}
		& > * {
			grid-area: stack;
		}
		&__content {
			color: #fff;
		}
		&__image {
			--aspect-ratio: 2/1;
			position: relative;
			z-index: -3;
			container-type: inline-size;
			width: 100%;

			&::before {
				content: '';
				background-color: oklab(from #000 l a b / 0.5);
				position: absolute;
				inset: 0;
			}
			img {
				min-height: 50dvw;
				width: 100%;
				aspect-ratio: var(--aspect-ratio);
				object-fit: cover;
				@container (width <=600px) {
					--aspect-ratio: 1/1.5;
				}
			}
		}
	}
	.countdown {
		border: 1px solid #fff;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		place-items: center;
		padding-inline: 1.5rem;
		padding-block: 1rem;
		max-width: 25rem;
		margin-inline: auto;
		border-radius: 0.75rem;
		margin-top: 2rem;

		& > span {
			display: grid;
			place-items: center;
			font-size: 2rem;
			width: 100%;
			padding-inline: 1.25rem;

			& + span {
				border-left: 1px solid #fff;
			}

			p {
				font-size: 1rem;
				font-weight: 300;
				text-transform: capitalize;
			}
		}
	}
</style>
