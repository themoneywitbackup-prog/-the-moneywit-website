---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layout/base-layout.astro';
import { campaignPage } from '@/data/campaign-page';
import { getCollection } from 'astro:content';
import CampaignsHero from './_components/campaigns-hero.astro';
import Countdown from './_components/count-down';
import { generateHTMLString } from '@/lib/contentful/html-parser';
import Testimonials from '@/modules/school/testimonials.astro';
import MeetOurFacilitator from './_components/meet-facilator';

export const getStaticPaths = (async () => {
	const content = await getCollection('campaignPage');
	const reshapeObject = content.map((data) => {
		return { props: data.data, params: { slug: data.data.slug } };
	});
	return reshapeObject;
}) satisfies GetStaticPaths;
const {
	title,
	description,
	backgroundImage,
	timeAndDate,
	paymentLinkOne,
	paymentLinkTwoDollar,
	pageContent,
	textForLink1,
	textForLink2,
} = Astro.props;
---

<BaseLayout>
	<CampaignsHero
		paymentText={textForLink1}
		payment2Text={textForLink2}
		title={title}
		description={description}
		image={backgroundImage}
		timeAndDate={new Date(timeAndDate)}
		paymentLink={paymentLinkOne}
		paymentLink2={paymentLinkTwoDollar}
	/>

	<section class='page-content'>
		<div
			class='page-content__container'
			set:html={generateHTMLString(pageContent)}
		/>
	</section>
	<Testimonials />
</BaseLayout>

<style lang='scss' is:global>
	@use '@/styles/fn' as fn;
	.our-facilitator {
		background-color: var(--white-bg);
		padding-block: max(2.5rem, min(7rem, 10cqw));
		container-type: inline-size;
		padding-inline: 1.25rem;

		&__title {
			font-size: fn.useResponsiveSize(300, 800, 32, 48);
			text-align: center;
			font-weight: 700;
			margin-bottom: 3.125rem;
		}
		&__container {
			max-width: var(--max-container);
			margin-inline: auto;
		}
		&__content {
			align-content: center;
			p + p {
				margin-top: 1.25rem;
			}
			img {
				margin-top: 2rem;
			}
		}
		&__image {
			img {
				aspect-ratio: 600/640;
				object-fit: cover;
				object-position: center center;
				border-radius: 1rem;
			}
		}
		&__layout {
			--number-columns: 2;
			display: grid;
			gap: 1.5rem;
			grid-template-columns: repeat(var(--number-columns), 1fr);
			@container (inline-size <= 730px) {
				--number-columns: 1;
			}
		}
	}
	.pageTextContent {
		background-color: #f7f6f4;
		padding-block: 5rem;
		padding-inline: 1.25rem;
		&__container {
			max-width: 48rem;
			margin-inline: auto;

			* + * {
				margin-top: 1rem;
			}
		}
	}
	.form-iframe {
		min-height: 50rem;
		@media (width <= 500px) {
			min-height: 43.75rem;
		}
	}

	.imaginePage {
		background: #ffffff;
		padding-block: 6rem;
		padding-inline: 1.25rem;
		font-family: 'Barlow', sans-serif;

		&__container {
			max-width: 930px;
			margin-inline: auto;
			display: flex;
			flex-direction: column;
			align-items: center;
		}

		&__title {
			font-size: 3rem;
			font-weight: 700;
			margin-bottom: 3rem;
			color: #1d1d1d;
			letter-spacing: -0.02em;
			text-align: center;
		}

		&__list {
			width: 100%;
			margin-bottom: 2.5rem;

			ul {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				align-items: flex-start;
			}

			li {
				display: flex;
				align-items: center;
				gap: 0.85rem;
				font-size: 1.2rem;
				color: #2d2d2d;
				padding-block: 0.75rem;
				font-weight: 300;
				width: fit-content;
				border-bottom: 1.5px solid #d1d1d1;
			}

			li::before {
				content: '✔✔';
				color: #f4a51c;
				font-size: 0.85rem;
				font-weight: 900;
				display: inline-flex;
				letter-spacing: -3px;
				margin-right: 0.5rem;
				transform: translateY(1px);
			}
		}

		&__subText {
			font-size: 1.35rem;
			color: #1d1d1d;
			line-height: 1.5;
			font-weight: 300;
			text-align: left;
			width: 100%;
			max-width: 100%;
		}
	}

	.forYouPage {
		background-color: #ffffff;
		padding-block: 5rem;
		padding-inline: 1.25rem;
		font-family: 'Barlow', sans-serif;

		&__container {
			max-width: 1000px;
			margin-inline: auto;
			display: flex;
			flex-direction: column;
		}

		&__title {
			text-align: center;
			font-size: 3rem;
			font-weight: 600;
			color: #1d1d1d;
			margin-bottom: 3.5rem;
			letter-spacing: -0.02em;
		}

		&__list-wrapper {
			align-self: center;
			width: fit-content;
			max-width: 100%;
		}

		&__list {
			ul {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				align-items: flex-start;
			}

			li {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				font-size: 1.25rem;
				color: #1d1d1d;
				font-weight: 500;
				padding-block: 0.85rem;
				width: fit-content;
				border-bottom: 1.5px solid #d1d1d1;
			}

			li::before {
				content: '\2192';
				color: #f4a51c;
				font-size: 1.5rem;
				font-weight: 900;
				display: inline-flex;
				margin-right: 0.5rem;
			}
		}
	}
	.clarityPage {
		background-color: #f2f2f2;
		padding-block: 6rem;
		padding-inline: 1.25rem;
		font-family: 'Barlow', sans-serif;

		&__container {
			max-width: 1200px;
			margin-inline: auto;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 4rem;

			@media (max-width: 900px) {
				flex-direction: column-reverse;
				text-align: left;
				gap: 2rem;
			}
		}

		&__image {
			flex: 1;
			display: flex;
			justify-content: flex-end;

			img {
				max-width: 450px;
				width: 100%;
				height: auto;
				border-radius: 8px;
				border: #1d1d1d solid;
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
			}

			@media (max-width: 900px) {
				justify-content: center;
				order: 2;
			}
		}

		&__content-wrapper {
			flex: 1;
			display: flex;
			flex-direction: column;
		}

		&__heading {
			font-size: 3.5rem;
			line-height: 1.1;
			font-weight: 800;
			color: #1d1d1d;
			margin-bottom: 2rem;
			text-transform: none;
			max-width: 1200px;
			width: 100%;

			@media (max-width: 640px) {
				font-size: 2.5rem;
			}
		}

		&__list {
			ul {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			li {
				display: flex;
				align-items: flex-start;
				gap: 0.75rem;
				font-size: 1.25rem;
				color: #333;
				font-weight: 400;
				line-height: 1.4;
			}

			li::before {
				content: '✔';
				display: flex;
				align-items: center;
				justify-content: center;
				min-width: 24px;
				height: 24px;
				background-color: #f4a51c;
				color: white;
				border-radius: 50%;
				font-size: 0.8rem;
				margin-top: 4px;
			}
		}
	}
	@media (max-width: 640px) {
		.imaginePage__title {
			font-size: 2.25rem;
		}
		.imaginePage__list li {
			font-size: 1.1rem;
		}
		.forYouPage__title {
			font-size: 2.25rem;
		}
		.forYouPage__list li {
			font-size: 1.1rem;
		}
		.forYouPage__list-wrapper {
			align-self: flex-start;
		}
	}
</style>
