---
import BaseLayout from '@/layout/base-layout.astro'
import SchoolHero from '@/modules/school/hero-section.astro'
import TrustedByLogo from '../components/trusted-by-logo.astro'
import OurPrograms from '@/modules/school/our-programs.astro'
import FreeResource from '@/modules/school/free-resources.astro'
import BrochureCTA from '../components/Landing-page/BrochureCTA.astro'
import Testimonials from '../modules/school/testimonials.astro'
import NewsletterCard from '@/modules/school/newsletter-card.astro'
import StatGrid from '@/components/ui/StatGrid.astro'
import PeopleIcon from '@/components/assets/icons/pepicons-pop_people.svg'
import ContinentsIcon from '@/components/assets/icons/Group.svg'
import GlobeIcon from '@/components/assets/icons/material-symbols_globe.svg'
import { getCollection } from 'astro:content'
import type { ImageMetadata } from 'astro'
import { schoolPageCollections } from '@/data/webpages'

interface Stat {
  target: number
  suffix?: string
  label: string
  icon: ImageMetadata
 

}

const stats: Stat[] = [
  {
    target: 300,
    suffix: 'K+',
    label: 'Individuals Reached',
    icon: PeopleIcon,
  },
  {
    target: 4,
    suffix: '+',
    label: 'Companies Served',
    icon: ContinentsIcon,
  },
  {
    target: 15,
    suffix: '+',
    label: 'Countries Impacted',
    icon: GlobeIcon,
  },
]
const schoolPageContent = await getCollection('schoolPageCollections')
const pageContent = schoolPageContent[0].data
const { schoolHeroTitle, schooHeroDesc, schoolHeroButtonText, schoolHeroButtonLink, schoolTrackHeader, schoolTrackDesc,schoolBrochure,schoolBrochureDesc,schoolBrochureButtonText,schoolBrochureButtonLink, newsletterHeader, newsletterDesc } = pageContent
---

<BaseLayout>
  <SchoolHero
    title={schoolHeroTitle}
    description={schooHeroDesc}
    buttonText={schoolHeroButtonText}
    buttonLink={schoolHeroButtonLink}
  />
  <TrustedByLogo />
  <OurPrograms />
  <StatGrid
    title={schoolTrackHeader}
    description={schoolTrackDesc}
    stats={stats}
    bgColor="bg-[#F7F6F4]"
    cardColor="bg-[#F2F1E8] border border-white/5"
    titleColor="text-[#231E15]"
    descColor="text-[#A7A7A7]"
    numColor="text-[#231E15]"
    labelColor="text-gray-400"
  />
  <FreeResource />
  <BrochureCTA
    heading={schoolBrochure}
    subtext={ schoolBrochureDesc}
    buttonText={ schoolBrochureButtonText}
    download={false}
    btnLink={schoolBrochureButtonLink}
  />
  <Testimonials />
  <NewsletterCard  title={newsletterHeader} description={newsletterDesc} />
</BaseLayout>
