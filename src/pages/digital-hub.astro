---
import BaseLayout from '@/layout/base-layout.astro'
import { Image } from 'astro:assets'
import { PATHS, testimonials } from '@/data/shop-data'

const categories = [
  { t: 'Tools', d: 'Working planners built by a CFA Charterholder not templates.' },
  { t: 'Products', d: 'Playbooks, checklists and workshops you can act on.' },
  { t: 'Online Courses', d: 'Structured programs you can run at your own pace.' },
  { t: 'Bespoke Sessions', d: 'One-on-one time with a CFA Charterholder of over 17 years of experience in Nigerian financial markets and Corporate Treasury.' },
]
---
<BaseLayout
  title="The Money Wit Digital Hub — Tools, Courses & Bespoke Sessions"
  description="Two clear paths to progress with your money: put your finances in order, or build your wealth."
>

<style>
  .hub-grid-bg {
    background-image: radial-gradient(circle at 1px 1px, rgba(10,10,10,0.15) 1px, transparent 0);
    background-size: 24px 24px;
  }
</style>

<!-- Hero -->
<section class="relative overflow-hidden border-b border-black/10">
  <div class="hub-grid-bg pointer-events-none absolute inset-0 opacity-35"></div>
  <div class="relative mx-auto flex max-w-5xl flex-col items-center px-6 pt-16 pb-14 text-center lg:px-10 lg:pt-24 lg:pb-20">
    <div class="mb-5 flex items-center justify-center gap-3 text-xs uppercase tracking-[0.3em] text-black/60">
      <span class="h-px w-8 bg-[#FFD100]"></span>
      The Money Wit Digital Hub
      <span class="h-px w-8 bg-[#FFD100]"></span>
    </div>
    <h1 class="mx-auto max-w-4xl font-bold text-5xl leading-[1] tracking-tight sm:text-6xl lg:text-7xl text-black">
      What are you trying to
      <span class="italic text-[#FFD100]"> achieve </span>
      with your money?
    </h1>
    <p class="mt-6 max-w-xl text-lg text-black/70">
      Pick a path. Every tool, product, course and bespoke session inside is organised around these two goals.
    </p>
  </div>
</section>

<!-- Two Paths -->
<section class="mx-auto max-w-7xl px-6 py-14 lg:px-10 lg:py-20">
  <div class="grid gap-6 lg:grid-cols-2">
    <a href="/digital-hub/finances" class="group relative flex min-h-[380px] flex-col justify-between overflow-hidden rounded-3xl border border-black bg-black text-white p-8 transition hover:-translate-y-1 lg:p-12">
      <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full opacity-20 blur-2xl bg-[#FFD100]"></div>
      <div>
        <div class="text-xs font-semibold uppercase tracking-[0.3em] opacity-80">Organize Your Finances</div>
        <h3 class="mt-4 font-bold text-4xl leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">I Want to Put My Finances in Order</h3>
        <p class="mt-5 max-w-md text-base opacity-85">See your money clearly, fix the leaks, and start compounding. Tools, products, courses and bespoke sessions to manage your finances with intention.</p>
      </div>
      <div class="mt-10 flex items-center justify-between">
        <span class="inline-flex items-center gap-3 rounded-full px-5 py-3 text-sm font-semibold uppercase tracking-widest transition group-hover:translate-x-1 bg-[#FFD100] text-black">
          Inside Each Hub →
        </span>
        <span class="text-xs opacity-60">Step in ↗</span>
      </div>
    </a>

    <a href="/digital-hub/invest" class="group relative flex min-h-[380px] flex-col justify-between overflow-hidden rounded-3xl border border-[#FFD100] bg-[#FFD100] text-black p-8 transition hover:-translate-y-1 lg:p-12">
      <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full opacity-20 blur-2xl bg-black"></div>
      <div>
        <div class="text-xs font-semibold uppercase tracking-[0.3em] opacity-80">Invest</div>
        <h3 class="mt-4 font-bold text-4xl leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">I Want to Build My Wealth</h3>
        <p class="mt-5 max-w-md text-base opacity-85">Learn where your money should go. Tools, products, courses and bespoke sessions to invest wisely locally and globally.</p>
      </div>
      <div class="mt-10 flex items-center justify-between">
        <span class="inline-flex items-center gap-3 rounded-full px-5 py-3 text-sm font-semibold uppercase tracking-widest transition group-hover:translate-x-1 bg-black text-[#FFD100]">
          Inside Each Hub →
        </span>
        <span class="text-xs opacity-60">Step in ↗</span>
      </div>
    </a>
  </div>
</section>

<!-- Inside Each Hub -->
<section class="border-t border-black/10 bg-[#F8F7F5]">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10 lg:py-20">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
      <div>
        <div class="mb-2 text-xs uppercase tracking-[0.3em] text-black/50">Inside Each Hub</div>
        <h2 class="font-bold text-3xl tracking-tight sm:text-4xl text-black">
          Real solutions <span class="italic text-[#FFD100]">moving you forward.</span>
        </h2>
      </div>
      <p class="max-w-md text-sm text-black/60">
        Each hub is a curated storefront designed to help you find the right tools, products, courses and bespoke sessions to move you forward financially.
      </p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {categories.map((c) => (
        <div class="rounded-2xl border border-black/10 bg-white p-5">
          <div class="text-xs font-mono uppercase tracking-widest text-[#FFD100] font-bold">{c.t}</div>
          <p class="mt-3 text-sm text-black/70">{c.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Testimonials -->
<section class="border-t border-black/10">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10 lg:py-20">
    <div class="mb-10 max-w-2xl">
      <div class="mb-2 text-xs uppercase tracking-[0.3em] text-black/50">What people say</div>
      <h2 class="font-bold text-3xl tracking-tight sm:text-4xl text-black">
        From the people who have done the work.
      </h2>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      {testimonials.map((t) => (
        <figure class="flex h-full flex-col justify-between rounded-3xl border border-black/10 bg-[#F8F7F5] p-6 lg:p-8">
          <span class="font-bold text-6xl leading-none text-[#FFD100]">&ldquo;</span>
          <blockquote class="mt-2 text-base leading-relaxed text-black/80 lg:text-lg">
            {t.quote}
          </blockquote>
          <figcaption class="mt-6 flex items-center gap-3 border-t border-black/10 pt-4 text-sm">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-black font-semibold text-white">
              {t.name.charAt(0)}
            </span>
            <span>
              <span class="block font-semibold text-black">{t.name}</span>
              {t.context && (
                <span class="block text-xs uppercase tracking-widest text-black/50">{t.context}</span>
              )}
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

</BaseLayout>
