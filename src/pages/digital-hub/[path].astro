---
import BaseLayout from "@/layout/base-layout.astro";
import { Image } from "astro:assets";
import {
  PATHS,
  bundles,
  groupByCategory,
  productsByPath,
  slugify,
  type Path,
} from "@/data/shop-data";

export function getStaticPaths() {
  return Object.keys(PATHS).map((path) => ({
    params: { path },
  }));
}

const { path } = Astro.params as { path: Path };

const meta = PATHS[path];

if (!meta) {
  return Astro.redirect("/digital-hub");
}

const products = productsByPath(path);
const grouped = groupByCategory(products, path);
---

<BaseLayout
  title={`${meta.title} — The Money Wit Digital Hub`}
  description={meta.blurb}
>

<section class="bg-[#F8F7F5] py-16">
  <div class="mx-auto max-w-7xl px-6">

    <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[#C9A227]">
      {meta.kicker}
    </p>

    <h1 class="mt-4 text-4xl font-black tracking-tight text-black md:text-6xl">
      {meta.title}
    </h1>

    <p class="mt-4 max-w-3xl text-lg text-black/70">
      {meta.tagline}
    </p>

    <p class="mt-3 max-w-3xl text-black/60">
      {meta.blurb}
    </p>

    <div class="mt-10 flex flex-wrap gap-3">

      {grouped.map(([category]) => (
        <a
          href={`#cat-${slugify(category)}`}
          class="rounded-full border border-black/15 px-4 py-2 text-xs font-semibold uppercase tracking-widest transition hover:border-black hover:text-black"
        >
          {category}
        </a>
      ))}

      <a
        href="#bundles"
        class="rounded-full bg-[#FFD100] px-4 py-2 text-xs font-semibold uppercase tracking-widest text-black"
      >
        Bundles
      </a>

    </div>

  </div>
</section>

{
  grouped.map(([category, items]) => (
    <section
      id={`cat-${slugify(category)}`}
      class="py-16"
    >
      <div class="mx-auto max-w-7xl px-6">

        <h2 class="mb-8 text-3xl font-bold">
          {category}
        </h2>

        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">

          {items.map((p) => {
            const isFree =
              p.price.toLowerCase() === "free" ||
              p.priceNumeric === 0;

            return (
              <a
                href={p.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col overflow-hidden rounded-2xl border border-black/10 bg-white transition duration-300 hover:-translate-y-1 hover:shadow-xl"
              >
                <div class="relative aspect-[4/3] overflow-hidden">

                  <Image
                    src={p.image}
                    alt={p.name}
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                  />

                  {p.featured && (
                    <span class="absolute left-4 top-4 rounded-full bg-[#FFD100] px-3 py-1 text-xs font-bold uppercase">
                      Featured
                    </span>
                  )}

                </div>

                <div class="flex flex-1 flex-col p-6">

                  <h3 class="text-xl font-bold">
                    {p.name}
                  </h3>

                  <p class="mt-3 text-sm text-black/65">
                    {p.short}
                  </p>

                  <p class="mt-4 text-sm text-black/60">
                    {p.description}
                  </p>

                  <div class="mt-auto flex items-center justify-between pt-6">

                    <span class="text-lg font-bold">
                      {isFree ? "FREE" : p.price}
                    </span>

                    <span class="font-semibold text-[#C9A227] group-hover:translate-x-1 transition">
                      {p.cta} →
                    </span>

                  </div>

                </div>

              </a>
            );
          })}

        </div>

      </div>
    </section>
  ))
}

<section
  id="bundles"
  class="bg-[#F8F7F5] py-16"
>

  <div class="mx-auto max-w-7xl px-6">

    <h2 class="mb-8 text-3xl font-bold">
      Bundles
    </h2>

    <div class="grid gap-8 md:grid-cols-2">

      {bundles.map((bundle) => (

        <div class="rounded-2xl border border-black/10 bg-white p-8">

          <h3 class="text-2xl font-bold">
            {bundle.name}
          </h3>

          <p class="mt-3 text-black/70">
            {bundle.description}
          </p>

          <ul class="mt-6 space-y-2">

            {bundle.includes.map((item) => (
              <li>• {item}</li>
            ))}

          </ul>

          <div class="mt-8 flex items-center justify-between">

            <span class="text-xl font-bold">
              {bundle.price}
            </span>

            <a
              href={bundle.href}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg bg-[#FFD100] px-6 py-3 font-semibold text-black transition hover:opacity-90"
            >
              {bundle.cta}
            </a>

          </div>

        </div>

      ))}

    </div>

  </div>

</section>

</BaseLayout>
