---
import HeroSection from '@/modules/home/hero-section.astro';
import BaseLayout from '../layout/base-layout.astro';
import TrustedByLogo from '../components/trusted-by-logo.astro';
import WhoIsMoneyWit from '@/modules/home/who-is-money-wit.astro';
import SchoolSection from '@/modules/home/school-section.astro';
import OurCommunity from '@/modules/home/our-community.astro';
import MediaHome from '@/modules/home/media-home.astro';
import BrochureCTA from '@/components/Landing-page/BrochureCTA.astro';
import ResourcesHome from '@/modules/home/resources-home.astro';
---

<BaseLayout>
	<HeroSection />
	<TrustedByLogo />
	<WhoIsMoneyWit />
	<SchoolSection />
	<OurCommunity />
	<MediaHome />
	<BrochureCTA
		heading='Partner with The Money Wit'
		subtext='Collaborate with us to reach a wider audience and make a greater impact on financial literacy.'
		buttonText='Become a Partner'
		download={false}
		btnLink=''
	/>
	<ResourcesHome />
	<iframe
		aria-label='Signup'
		frameborder='0'
		class='form-iframe'
		style='width:99%;border:none;'
		src='https://forms.zohopublic.com/oleroladelecom/form/Signup/formperma/BMLvnK5CEPZ7PMRlSjEgXaSolP-DhbtuLSTK44wAw5s'
	></iframe>
</BaseLayout>
<style lang='scss'>
	.form-iframe {
		min-height: 50rem;
		@media (width <= 500px) {
			min-height: 43.75rem;
		}
	}
</style>
