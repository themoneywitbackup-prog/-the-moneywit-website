---
import BaseLayout from '@/layout/base-layout.astro';
import CorporateHero from '@/modules/corporate/hero-section.astro';
import StaffSection from '@/modules/corporate/staff-section.astro';
import HeadlineSection from '@/modules/corporate/HeadlineSection.astro';
import SecondHeadline from '@/modules/corporate/secondHeadline.astro';
import SupportSection from '@/modules/corporate/support-section.astro';
import ImpactSection from '@/modules/corporate/impact-section.astro';
import Testimonials from '@/components/Landing-page/Testimonials.astro';
import OurStaffComponent from '@/components/Landing-page/services.astro';
import { getCollection } from 'astro:content';
const corporatePageContent = await getCollection(
	'corporatePageCollections',
);
const pageContent = corporatePageContent[0].data;

const customerTestimonialPageContent = await getCollection(
	'customerTestimonialPageCollections',
);

const customerContent = customerTestimonialPageContent.map(
	(data) => data.data,
);

const {
	heroTitle,
	heroButtonText,
	heroButtonLink,
	firstHeadlineTitile,
	firstHeadlineDesc,
	firstHeadlineButtonText,
	firstHeadlineButtonLink,
	secondHeadlineTitle,
	secondHeadlineDesc,
	secondHeadlineButtonText,
	secondHeadlineButtonLink,
	supportStaffTitle,
	supportStaffDesc,
	impactSpreadTitle,
	impactSpreadDescOne,
	impactSpreadDescTwo,
} = pageContent;
---

<BaseLayout>
	<CorporateHero
		corporateHeroHeader={heroTitle}
		corporateHeroButtonText={heroButtonText}
		corporateHeroButtonLink={heroButtonLink}
	/>
	<OurStaffComponent
		defaultTab='Workshops'
		title='For Your Staff'
		category='corporate'
		subtitle='Flexible, self-paced learning that covers the foundations of money management, saving, and investing..'
	/>
	<HeadlineSection
		heading={firstHeadlineTitile}
		subtext={firstHeadlineDesc}
		buttonText={firstHeadlineButtonText}
		headlineUrl={firstHeadlineButtonLink}
	/>
	<SecondHeadline
		heading={secondHeadlineTitle}
		subtext={secondHeadlineDesc}
		buttonText={secondHeadlineButtonText}
		headlineUrl={secondHeadlineButtonLink}
	/>
	<SupportSection
		title={supportStaffTitle}
		description={supportStaffDesc}
	/>
	<ImpactSection
		title={impactSpreadTitle}
		descOne={impactSpreadDescOne}
		descTwo={impactSpreadDescTwo}
	/>
	<iframe
		class='form-iframe-c'
		aria-label='2026 Corporate Financial Wellness Brochure'
		frameborder='0'
		style='height:500px;width:99%;border:none;'
		src='https://forms.zohopublic.com/oleroladelecom/form/2026Corporatelist/formperma/uyhr75kJ3NVmaV7aKbmQVO15zkqFPV_RgSyswb437eE'
	></iframe>
	<Testimonials testimonials={customerContent} />
</BaseLayout>

<style lang='scss'>
	.form-iframe-c {
		min-height: 100dvh;

		@media (width <=500px) {
			min-height: 53.75rem;
		}
	}
</style>
