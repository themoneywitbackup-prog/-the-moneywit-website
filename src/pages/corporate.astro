---
import BaseLayout from '@/layout/base-layout.astro';
import CorporateHero from '@/modules/corporate/hero-section.astro';
import StaffSection from '@/modules/corporate/staff-section.astro';
import HeadlineSection from '@/modules/corporate/HeadlineSection.astro';
import SecondHeadline from '@/modules/corporate/secondHeadline.astro';
import SupportSection from '@/modules/corporate/support-section.astro';
import ImpactSection from '@/modules/corporate/impact-section.astro';
import Testimonials from '@/components/Landing-page/Testimonials.astro';
import OurStaffComponent from '@/components/Landing-page/services.astro';
---

<BaseLayout>
	<CorporateHero />
	<OurStaffComponent
		defaultTab='Workshops'
		title='For Your Staff'
		category='corporate'
		subtitle='Flexible, self-paced learning that covers the foundations of money management, saving, and investing..'
	/>
	<HeadlineSection />
	<SecondHeadline />
	<SupportSection />
	<ImpactSection />
	<Testimonials />
</BaseLayout>
